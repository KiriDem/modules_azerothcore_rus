[worldserver]

########################################
# Настройки Individual Progression
########################################

# IndividualProgression.Enable
#
#        Описание: Включить модуль индивидуального прогресса
#                  Обратите внимание: как и в случае со всеми модулями AzerothCore, изменения в базе данных нельзя отменить через настройки конфигурации.
#                  Это означает, что такие изменения игрового мира, как восстановление заданий и характеристик NPC версии Vanilla, сохранятся даже при отключении модуля.
#                  Отключение модуля приведет к деактивации таких функций, как ограничения доступа, лимиты уровня, корректировка урона и т. д.
#
#        По умолчанию:     1 - Включенно
#                          0 - Выключенно
#
IndividualProgression.Enable = 1

# IndividualProgression.EnforceGroupRules
#
#        Описание: Включите эту настройку, чтобы разрешить игрокам объединяться в группы только с теми, кто находится на том же этапе прохождения.
#
#        По умолчанию:     0 - Выключенно
#                          1 - Включенно
#
IndividualProgression.EnforceGroupRules = 0

# IndividualProgression.VanillaPowerAdjustment
#
#        Описание: Корректировка силы атаки игрока при прохождении контента оригинальной версии игры (Vanilla) и до открытия Темного портала
#                  Это сделано для того, чтобы лучше передать ощущения от оригинальной игры при прохождении соответствующего контента
#                  Применяется линейно в зависимости от уровня (в диапазоне с 11-го по 60-й уровень)
#
#        По умолчанию: 1 - Без корректировки
#        Предложено:   от 0,5 до 0,6 (50–60% от обычного урона)
#
IndividualProgression.VanillaPowerAdjustment = 1

# IndividualProgression.VanillaHealingAdjustment
#
#        Описание: Корректировка силы исцеления игрока при прохождении контента оригинальной версии игры (Vanilla) и до открытия Темного портала
#                  Это сделано для того, чтобы лучше передать ощущения от оригинальной игры при прохождении соответствующего контента
#                  Корректировка применяется линейно в зависимости от уровня (в диапазоне с 11-го по 60-й уровень)
#
#        По умолчанию: 1 - Без корректировки
#        Предложено:   0,5 (50% от обычного исцеления)
#
IndividualProgression.VanillaHealingAdjustment = 1

# IndividualProgression.TBCPowerAdjustment
#
#        Описание: Корректировка силы атаки игрока после открытия Темного портала, но до завершения контента TBC
#                  Это сделано для того, чтобы лучше передать ощущения от TBC при прохождении контента TBC
#                  В отличие от корректировки для Vanilla, здесь всегда используется фиксированное значение
#
#        По умолчанию: 1 - Без корректировки
#        Предложено:   от 0,5 до 0,6 (50–60% от обычного урона)
#
IndividualProgression.TBCPowerAdjustment = 1

# IndividualProgression.TBCHealingAdjustment
#
#        Описание: Корректировка силы исцеления игрока после открытия Темного портала, но до завершения контента TBC
#                  Это призвано обеспечить более точное ощущение от TBC при прохождении контента TBC
#                  В отличие от корректировки для Vanilla, здесь всегда используется фиксированное значение
#
#        По умолчанию: 1 - Без корректировки
#        Предложено:   от 0,5 до 0,6 (50–60% от обычного исцеления)
#
IndividualProgression.TBCHealingAdjustment = 1

# IndividualProgression.BotOnlyAdjustments
#
#        Описание: В подземельях и рейдах изменения, касающиеся версий Vanilla и TBC, затрагивают только RND-ботов.
#                  Усложнение подземелий и рейдов без влияния на реальных игроков.
#
#        По умолчанию: 0 - Выключенно
#                      1 - Включенно
#
IndividualProgression.BotOnlyAdjustments = 0

# IndividualProgression.QuestXPFix
#
#        Описание: Опыт за задания эпохи Vanilla и TBC был увеличен в патчах 2.3.0 и 3.0.2 в качестве механизма ускоренной прокачки.
#                  Включите эту опцию, чтобы снизить опыт за соответствующие задания и приблизить его к исходным значениям.
#
#        По умолчанию: 1 - Включенно
#                      0 - Выключенно
#
IndividualProgression.QuestXPFix = 1

# IndividualProgression.RequireNaxxStrathEntrance
#
#        Описание: Если эта опция включена, игрокам потребуется сначала попасть в Naxx 40 через оригинальный вход времен бета-тестирования
#                  (в глубине Стратхольма) и лишь затем они смогут воспользоваться кристаллом телепортации в Восточных Чумных землях (EPL).
#                  Это соответствует механике других рейдов эпохи Vanilla (MC, BWL).
#                  Если опция отключена, игроки смогут попасть в Naxx 40 через кристалл сразу после получения доступа (аттюна)
#                  и достижения необходимого этапа прогресса — проходить Стратхольм не потребуется.
#
#        По умолчанию: 0 - Выключенно
#                      1 - Включенно
#
IndividualProgression.RequireNaxxStrathEntrance = 0

# IndividualProgression.doableNaxx40Bosses
#
#        Описание: Если эта опция включена, некоторые боссы в Naxx40 станут проще.
#                  - Урон от способностей Четырех всадников будет значительно снижен.
#                    Благодаря этому с ними можно будет сражаться одновременно, не прибегая к особой тактике.
#                    Кроме того, будет отключена «Зона пустоты» (Void Zone) Блаумекс. Боты не выходят из зоны действия АоЕ-заклинаний,
#                    пока не получат урон, поэтому они сильно страдали от этой способности.
#                  - Глут будет искать зомби каждые 12 секунд вместо 3.
#                  - «Ненавистный удар» (Hateful Strike) Лоскутика будет наносить 80% от обычного урона.
#                  - Разувиус будет применять «Разрушительный крик» (Disrupting Shout) вместо «Сжигания маны» (Mana Burn).
#
#        По умолчанию: 0 - Выключенно
#                      1 - Включенно
#
IndividualProgression.doableNaxx40Bosses_4H = 0
IndividualProgression.doableNaxx40Bosses_Gluth = 0
IndividualProgression.doableNaxx40Bosses_Patchwerk = 0
IndividualProgression.doableNaxx40Bosses_Razuvious = 0

# IndividualProgression.MoltenCore.ManualRuneHandling
#
#        Описание: Определяет, обрабатываются ли руны в «Огненных недрах» вручную (путем гашения с помощью «Водной квинтэссенции»)
#                  или автоматически при победе над боссами (стандартный режим WotLK)
#
#        По умолчанию: 1 - Включенно (требует заливки водой)
#                      0 - Выключенно (автоматически, срабатывает после победы над боссами)
#
IndividualProgression.MoltenCore.ManualRuneHandling = 1

# IndividualProgression.MoltenCore.AqualEssenceCooldownReduction
#
#        Описание: Сокращает время восстановления «Вечных квинтэссенций» на указанную величину.
#
#        По умолчанию: 0 - Выключенно (Время восстановления — 1 час)
#                      60 - (Без перезарядки)
#
IndividualProgression.MoltenCore.AqualEssenceCooldownReduction = 0

# IndividualProgression.SerpentshrineCavern.RequireAllBosses
#
#        Описание: Для доступа к панели управления Вашджа необходимо убить всех боссов.
#
#        По умолчанию: 1 - Включенно
#                      0 - Выключенно
#
IndividualProgression.SerpentshrineCavern.RequireAllBosses = 1

# IndividualProgression.TheEye.RequireAllBosses
#
#        Описание: Для открытия дверей Каэлю необходимо убить всех боссов.
#
#        По умолчанию: 1 - Включенно
#                      0 - Выключенно
#
IndividualProgression.TheEye.RequireAllBosses = 1

# IndividualProgression.FishingFix
#
#        Описание: До выхода обновления 3.1 у навыка рыбной ловли существовала система прогрессии:
#                  чтобы повышать уровень навыка в высокоуровневых зонах, сначала нужно было прокачать его в зонах низкого уровня.
#                  В обновлении 3.1 это правило изменили, позволив повышать уровень навыка даже при вылове «мусора»
#                  в высокоуровневых зонах, что фактически позволяло пропустить этап начальной прокачки.
#                  Данное изменение отменяет это нововведение.
#
#        По умолчанию: 1 - Включенно (Поведение до версии 3.1 — для рыбалки требуется продвижение по уровням зон.)
#                      0 - Выключенно (Изменение после версии 3.1 — возможность повышать навык рыбной ловли в любой локации.)
#
IndividualProgression.FishingFix = 1

# IndividualProgression.SimpleConfigOverride
#
#        Описание: Если эта опция включена, модуль сможет задать несколько параметров конфигурации AzerothCore.
#                  Первые два параметра обязательны для работы модуля.
#                  Если вы не хотите использовать сокращенное время дыхания под водой,
#                  отключите эту опцию и самостоятельно настройте первые два параметра в файле worldserver.conf.
#
#                  Измененные настройки:
#                  - Включить PlayerSettings (требуется модулем Individual Progression)
#                  - Отключить принудительное использование атрибутов предметов из DBC, чтобы изменения предметов версии Vanilla могли переопределять значения клиента
#                  - Таймер дыхания под водой установлен на 1 минуту (значение Vanilla, в WotLK оно было изменено на 3 минуты)
#
#        По умолчанию: 1 - Включенно
#                      0 - Выключенно
#
IndividualProgression.SimpleConfigOverride = 1

# IndividualProgression.DisableQuestMarkers
#
#        Описание: Отключить маркеры и мерцание квестовых объектов (добавлены в патче 2.3)
#
#        По умолчанию: 1 - Маркеры и блестки отключены
#                      0 - Маркеры и блестки включены
#
IndividualProgression.DisableQuestMarkers = 1

# IndividualProgression.DisableRDF
#
#        Описание: Включите или отключите функцию случайного подбора подземелий (Random Dungeon Finder) в рамках системы индивидуального прогресса.
#                  Возможность вставать в очередь на конкретные подземелья и праздничные события сохранится.
#                  (Используйте DungeonFinder.OptionsMask в файле worldserver.conf, чтобы полностью отключить инструмент поиска группы.)
#
#        По умолчанию: 0 - RDF включен
#                      1 - RDF выключен
#
IndividualProgression.DisableRDF = 0

# IndividualProgression.MaxMonsterSight
#
#        Описание: Включить или отключить максимальную дальность обзора монстров (Max Monster Sight).
#                  Стандартное значение для Alterac Valley — 50 ярдов. Включение этой опции увеличит дальность до 80 ярдов.
#                  Это сделано из-за лучников на башнях и в бункерах на поле боя Alterac Valley.
#                  Данная настройка НЕ ​​влияет на радиус агро.
#
#        По умолчанию: 1 - Включенно
#                      0 - Выключенно
#
IndividualProgression.MaxMonsterSight = 1

# IndividualProgression.QuestMoneyAtLevelCap
#
#        Описание: Если эта функция включена, игроки, достигшие максимального уровня для текущего этапа прогрессии,
#                  будут получать дополнительные деньги за выполнение заданий. Она была добавлена ​​в патче 1.10.
#                  (Обратите внимание: выполнение заданий при достижении максимального уровня сервера, заданного в файле
#                  worldserver.conf, всегда будет приносить дополнительные деньги, так как это жестко запрограммировано в AzerothCore.)
#
#        По умолчанию: 1 - Включенно
#                      0 - Выключенно
#
IndividualProgression.QuestMoneyAtLevelCap = 1

# IndividualProgression.RepeatableVanillaQuestsXP
#
#        Описание: В оригинальной версии игры (Vanilla) некоторые повторяющиеся задания приносили опыт при каждой сдаче.
#                  Включите эту функцию, чтобы сохранить механику Vanilla: опыт будет начисляться при каждой сдаче задания.
#                  Отключите её, чтобы использовать механику WotLK: опыт будет начисляться только один раз.
#
#        По умолчанию: 1 - Включенно
#                      0 - Выключенно
#
IndividualProgression.RepeatableVanillaQuestsXP = 1

# IndividualProgression.ProgressionLimit
#
#        Описание: Если эта опция включена, игроки не смогут продвинуться дальше данного этапа прогресса.
#                  Значения этапов прогресса см. в файле IndividualProgression.h (перечисление ProgressionState).
#                  Например, значение 7 ограничит игроков контентом базовой версии игры (Vanilla).
#
#        По умолчанию: 0 - Выключенно (Игроки могут продвинуться до максимального, 18-го этапа развития, соответствующего завершению контента WotLK.)
#                      1-17 - Установите более низкий максимально достижимый этап прогресса.
#
IndividualProgression.ProgressionLimit = 0

# IndividualProgression.StartingProgression
#
#        Описание: Если эта опция включена, игроки будут начинать игру с данного этапа прогресса.
#                  Игроки, находящиеся на более раннем этапе, при входе в игру будут переведены на этот этап.
#                  Значения этапов прогресса см. в перечислении ProgressionState (файл IndividualProgression.h).
#
#        По умолчанию: 0 - Выключенно (начать с этапа 0)
#                      1-18 - Установить более высокий начальный этап прогрессии
#
IndividualProgression.StartingProgression = 0

# IndividualProgression.TbcRacesUnlockProgression
#
#        Описание: Этап прогрессии, на котором станут доступны расы TBC (дренеи и эльфы крови).
#                  Расы станут доступны, когда игрок достигнет этого уровня любым персонажем на своей учетной записи.
#                  Отключите эту опцию, чтобы расы TBC были доступны по умолчанию.
#                  Значения этапов прогрессии см. в перечислении (enum) ProgressionState в файле IndividualProgression.h.
#                  Игроки не смогут посещать стартовые зоны TBC, пока им не станут доступны расы TBC.
#
#        По умолчанию: 0 — Расы TBC доступны для создания всегда
#                      8 — Для создания дренеев и эльфов крови необходимо завершить контент оригинальной игры (Vanilla)
#                      1–7, 9–18 — Установка иного этапа прогресса, необходимого для создания персонажей рас TBC
#
IndividualProgression.TbcRacesUnlockProgression = 0

# IndividualProgression.tbcRacesStartingProgression
#
#        Описание: Этап развития, с которого начнут игру дренеи и эльфы крови.
#
#        По умолчанию: 0 — Дренеи и эльфы крови начинают с этапа 0
#                      8 — Дренеи и эльфы крови начинают с начала TBC
#
IndividualProgression.tbcRacesStartingProgression = 0

# IndividualProgression.DeathKnightUnlockProgression
#
#        Описание: Этап прогрессии, по достижении которого становится возможным создание персонажей класса «Рыцарь смерти».
#                  Рыцари смерти станут доступны, когда игрок достигнет этого уровня любым персонажем на своей учетной записи.
#                  Отключите эту опцию, чтобы сделать класс «Рыцарь смерти» доступным по умолчанию.
#                  Обратите внимание: все прочие ограничения на создание рыцарей смерти, заданные в файле worldserver.conf, продолжают действовать.
#                  По умолчанию создание рыцарей смерти запрещено до тех пор, пока не будет пройден контент дополнения TBC.
#                  Это связано с тем, что до выхода дополнения WotLK в игре отсутствовал надлежащий баланс прогрессии для рыцарей смерти.
#
#        По умолчанию: 13 — Для создания рыцарей смерти необходимо завершить TBC
#                      0 — Рыцари смерти доступны для создания всегда
#                      1–12, 14–18 — Установить иной этап прогресса, необходимый для создания рыцарей смерти
#
IndividualProgression.DeathKnightUnlockProgression = 13

# IndividualProgression.DeathKnightStartingProgression
#
#        Описание: Этап прогрессии, с которого начнут игру персонажи класса «Рыцарь смерти».
#
#        По умолчанию: 13 — Рыцари смерти начинают игру с начального этапа WotLK
#                      0–12, 14–18 — Установить для рыцарей смерти иной этап начального прогресса
#
IndividualProgression.DeathKnightStartingProgression = 13

# IndividualProgression.RequiredZulGurubProgression
#
#        Описание: The progression stage at which Zul'Gurub will be available
#
#        По умолчанию: 3 — Зул'Гуруб открывается после BWL (по умолчанию, как в Blizzlike)
#                      0-18 — Установить другой необходимый этап развития для Зул'Гуруба.
#
IndividualProgression.RequiredZulGurubProgression = 3

# IndividualProgression.RequiredZulAmanProgression
#
#        Описание: Этап прогресса, на котором станет доступен Зул'Аман
#
#        По умолчанию: 12 — Зул'Аман открывается после Черного храма (по умолчанию, как на официальном сервере)
#        Предложено:   9 — Зул'Аман открывается после Каражана / принца Малчезара.
#                      0–18 — Установить другой этап прогресса, необходимый для доступа к Зул'Аману.
#
IndividualProgression.RequiredZulAmanProgression = 12

# IndividualProgression.DisableDefaultProgression
#
#        Описание: Отключите стандартный механизм прогрессии, чтобы развитие осуществлялось исключительно через пользовательские записи прогрессии существ.
#
#        По умолчанию: 0 — Стандартная прогрессия
#                      1 — Пользовательская прогрессия
#
IndividualProgression.DisableDefaultProgression = 0

# IndividualProgression.CustomProgression
#
#        Описание: Список ID существ, сопоставленных с состояниями прогресса. Когда игрок побеждает существо из этого списка,
#                  для него устанавливается соответствующее состояние прогресса. Используется для создания нестандартной системы продвижения.
#                  Это заменит стандартную систему прогресса. Состояния прогресса, для которых не задано условие убийства конкретного существа, останутся без изменений.
#
#        Пример: IndividualProgression.CustomProgression = "639 8, 3975, 13"
#                Это позволит игрокам получить доступ к TBC после победы над ВанКлифом (ID 639) и к Нордсколу — после победы над Геродом (ID 3975).
#                Работает только для существ рангом выше «Элиты» (ELITE), чтобы избежать проверки прогресса после каждого убийства.
#
#        По умолчанию: "" - Пусто (по умолчанию)
#
IndividualProgression.CustomProgression = ""

# IndividualProgression.AllowEarlyDungeonSet2
#
#        Описание: Комплект подземелий 2-го уровня (Dungeon Set 2) был добавлен в обновлении 1.10
#                  для его получения требуется пройти часть контента Ан'Киража (AQ), который обычно становится доступен лишь на более позднем этапе игры.
#                  Эта настройка открывает доступ к соответствующему контенту раньше обычного, позволяя получить комплект
#                  подземелий 2-го уровня до того, как он утратит актуальность на фоне рейдовой экипировки.
#
#        По умолчанию: 0 - Выключенно
#                      1 - Включенно
#
IndividualProgression.AllowEarlyDungeonSet2 = 0

# IndividualProgression.AllowEarlyScourgeBosses
#
#        Описание: Событие «Вторжение Плети» добавляет 6 боссов подземелий, доступных только на 6-м этапе прогресса.
#                  На этом этапе игроки вряд ли станут возвращаться в низкоуровневые подземелья.
#                  Эта настройка позволяет сразиться с данными боссами на раннем этапе, пока они еще не утратили своей актуальности.
#
#        По умолчанию: 0 - Выключенно
#                      1 - Включенно
#
IndividualProgression.AllowEarlyScourgeBosses = 0

# IndividualProgression.TBC.ArenaSeason
#
#        Описание: Текущий ID сезона арены TBC
#        По умолчанию: 1
#                      1-4
#
IndividualProgression.TBC.ArenaSeason = 1

# IndividualProgression.WotLK.ArenaSeason
#
#        Описание: Текущий ID сезона арены WotLK
#        По умолчанию: 5
#                      5-8
#
IndividualProgression.WotLK.ArenaSeason = 5

# IndividualProgression.VanillaPvPRankRequirement
#
#        Описание: Требуемое количество убийств чести в PvP-версии игры (Vanilla) для получения каждого PvP-ранга, соответствующих званий и предметов.
#
IndividualProgression.VanillaPvpKillRequirement.Rank1 = 100
IndividualProgression.VanillaPvpKillRequirement.Rank2 = 200
IndividualProgression.VanillaPvpKillRequirement.Rank3 = 400
IndividualProgression.VanillaPvpKillRequirement.Rank4 = 800
IndividualProgression.VanillaPvpKillRequirement.Rank5 = 1400
IndividualProgression.VanillaPvpKillRequirement.Rank6 = 2000
IndividualProgression.VanillaPvpKillRequirement.Rank7 = 3000
IndividualProgression.VanillaPvpKillRequirement.Rank8 = 4500
IndividualProgression.VanillaPvpKillRequirement.Rank9 = 6000
IndividualProgression.VanillaPvpKillRequirement.Rank10 = 8000
IndividualProgression.VanillaPvpKillRequirement.Rank11 = 10000
IndividualProgression.VanillaPvpKillRequirement.Rank12 = 13000
IndividualProgression.VanillaPvpKillRequirement.Rank13 = 18000
IndividualProgression.VanillaPvpKillRequirement.Rank14 = 24000

# IndividualProgression.VanillaPvpTitlesPersistAfterVanilla
#
#        Описание: Игроки сохраняют свои PvP-звания времен оригинальной версии игры (Vanilla) даже после перехода на этапы TBC или WotLK.
#
#        По умолчанию: 1 - Включенно (По умолчанию, в стиле Blizzard)
#                      0 - Выключенно
#
IndividualProgression.VanillaPvpTitlesPersistAfterVanilla = 1

# IndividualProgression.VanillaPvpEarnTitlesAfterVanilla
#
#        Описание: Игроки могут продолжать получать новые PvP-звания времен оригинальной игры (Vanilla) даже после перехода к контенту TBC или WotLK.
#
#        По умолчанию: 0 - Выключенно (По умолчанию, в стиле Blizzard)
#                      1 - Включенно
#
IndividualProgression.VanillaPvpEarnTitlesAfterVanilla = 0

# IndividualProgression.BotAccountsEarnPvPTitles
#
#        Описание: Включить / отключить получение PvP-званий для учетных записей ботов.
#
#        По умолчанию: 0 - Выключенно
#                      1 - Включенно
#
IndividualProgression.BotAccountsEarnPvPTitles = 0

# IndividualProgression.BotAccountsMaxLevel
#
#        Описание: Установите максимальный уровень для учетных записей ботов.
#
#        По умолчанию: 80
#
IndividualProgression.BotAccountsMaxLevel = 80

# IndividualProgression.BotAccountsRegex
#
#        Описание: Регулярное выражение для поиска имен учетных записей, которые следует исключить из системы индивидуального прогресса.
#                  Это касается учетных записей, используемых для ботов.
#                  Если включен модуль Playerbots, выражение «^RNDBOT.*» исключит случайных ботов (randombots) из системы индивидуального прогресса.
#                  Чтобы добавить дополнительные учетные записи, используйте заглавные буквы и следующий формат: «(^RNDBOT.*|TEST1|TEST2)»
#
#        По умолчанию: "^RNDBOT.*"
#
IndividualProgression.BotAccountsRegex = "^RNDBOT.*"

# IndividualProgression.ExcludedAccountsRegex
#
#        Описание: Регулярное выражение для поиска имен учетных записей, которые следует исключить из системы индивидуального прогресса.
#                  Это полезно для учетных записей, используемых для тестирования или иных целей, где не требуется отслеживать прогресс.
#                  Чтобы добавить дополнительные учетные записи, используйте заглавные буквы и следующий формат: "(ACCOUNTA|ACCOUNTB)"
#
#        По умолчанию: ""
#
IndividualProgression.ExcludedAccountsRegex = ""

# IndividualProgression.EnableAllSpellRanks
#
#        Описание: Включите эту опцию, чтобы разрешить использование заклинаний всех рангов в период WotLK.
#                  В WotLK стоимость всех рангов заклинаний в процентах от запаса маны была одинаковой, поэтому не было смысла использовать заклинания низких рангов.
#                  По умолчанию система индивидуального прогресса блокирует заклинания рангов Vanilla и TBC после перехода игрока к контенту WotLK.
#                  Это сделано потому, что при использовании patch-V для заклинаний Vanilla и TBC восстанавливается фиксированная стоимость маны.
#                  В WotLK их быть не должно. Однако, если вы всё же хотите сделать их доступными, можно включить эту настройку.
#
#        По умолчанию: 0 - Выключенно
#                      1 - Включенно
#
IndividualProgression.EnableAllSpellRanks = 0

# IndividualProgression.EnableSetRepCommand
#
#        Описание: Включить команду .ip setrep для обычных учетных записей и учетных записей ГМ (GM).
#                  Эта команда устанавливает репутацию у определенных фракций на тот же уровень, что и у персонажа
#                  с самым высоким показателем репутации на данной учетной записи.
#                  Во избежание злоупотреблений команда по умолчанию не работает для фракций, с которыми у персонажа
#                  еще нет статуса «Нейтрально», «Дружелюбие» или «Уважение» (в зависимости от конкретной фракции).
#                  Используйте параметр IndividualProgression.sharedFactionIdsRegex, чтобы указать фракции, репутацию которых
#                  игроки могут переносить между персонажами на своей учетной записи.
#
#        По умолчанию: 0 - Выключенно
#                      1 - Включенно
#
IndividualProgression.EnableSetRepCommand = 0

# IndividualProgression.LimitedSetRepCommand
#
#        Описание: Во избежание злоупотреблений, для получения репутации у фракции игрок уже должен иметь с ней
#                  определенный уровень отношений (нейтральный, дружелюбный или «почтение» — в зависимости от конкретной фракции).
#                  Это предотвращает ситуацию, когда группа из 5 персонажей сдает задание по очереди, используя между
#                  сдачей команду «.ip setrep» и получая тем самым пятикратный объем репутации.
#                  Требование уровня «почтение» означает, что игрок уже выполнил большинство заданий или самостоятельно набрал определенное количество репутации.
#                  Для PvP-фракций достаточно нейтрального уровня репутации, поэтому данное ограничение на них
#                  не распространяется (полный список см. в файле cs_individualProgression.cpp).
#                  Исключениями являются фракции Алдоры, Провидцы и Род Ноздорму: для них уровень «почтение» обязателен, даже если эта настройка отключена.
#
#        По умолчанию: 1 - Включенно
#                      0 - Выключенно
#
IndividualProgression.LimitedSetRepCommand = 1

# IndividualProgression.sharedFactionIdsRegex
#
#        Описание: Это список идентификаторов фракций, которые игрок может сделать общими для других персонажей на своей учетной записи.
#                  Необходимо включить команду EnableSetRepCommand.
#                  Допустимые идентификаторы фракций: 
#                    - vanilla = 59|270|349|509|510|529|576|589|609|729|730|749|889|890|909|910
#                    - tbc     = 922|932|933|934|935|941|942|946|947|967|970|978|989|990|1011|1012|1015|1031|1038|1077
#                    - wotlk   = 1037|1052|1073|1090|1091|1094|1098|1119|1124|1156
#
#                    см. также: https://www.wowhead.com/wotlk/factions
#
#        По умолчанию: "59|270|349|509|510|529|576|589|609|729|730|749|889|890|909"
#
IndividualProgression.sharedFactionIdsRegex = "59|270|349|509|510|529|576|589|609|729|730|749|889|890|909"
