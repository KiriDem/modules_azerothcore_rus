# Credits: silviu20092
#

[worldserver]

########################################
# настройки mod-autosort
########################################
#
#    AutoSort.Enable
#        Описание: Главный переключатель всего модуля.
#        По умолчанию:     1 (Включенно)

AutoSort.Enable = 1

#
#    AutoSort.MergeStacks
#        Описание: Перед сортировкой объедините неполные стопки одинаковых предметов
#                  в минимально возможное количество стопок.
#        По умолчанию:     1 (Включенно)

AutoSort.MergeStacks = 1

#
#    AutoSort.SortBags
#        Описание: Физическая пересортировка предметов в сумках или банке (сортировка по качеству, 
#                  типу или названию — как кнопка «Сортировать сумки» в актуальной версии игры)
#        По умолчанию:     1 (Включенно)

AutoSort.SortBags = 1

#
#    AutoSort.OnLogin
#        Описание: Автоматически сортировать рюкзак и сумки игрока при каждом входе в игру.
#        По умолчанию:     0 (Выключенно)

AutoSort.OnLogin = 0

#
#    AutoSort.Cooldown
#        Описание: Минимальное время (в секундах), которое игрок должен выждать между использованиями
#                  команды .sort, чтобы предотвратить злоупотребление или спам.
#        По умолчанию:     5

AutoSort.Cooldown = 5

#
#    AutoSort.PinnedItems
#        Описание: Список идентификаторов (разделенных запятыми), которые всегда должны располагаться
#                  перед остальными элементами в указанном порядке (первый — с наивысшим приоритетом).
#                  Закрепленный предмет занимает первую ячейку в группе
#                  слотов рюкзака или обычной сумки, пока он фактически
#                  находится в этой группе.
#                  По умолчанию закрепляется Камень возвращения (entry 6948).
#        По умолчанию:     "6948"

AutoSort.PinnedItems = "6948"

#
#    AutoSort.Periodic.Enable
#        Описание: Автоматическая сортировка рюкзака или сумок игрока каждые N секунд,
#                  пока он находится в сети (см. «Интервал»).
#        По умолчанию:     0 (Выключенно)

AutoSort.Periodic.Enable = 0

#
#    AutoSort.Periodic.Interval
#        Описание: Как часто (в секундах) следует запускать периодическую сортировку,
#                  для каждого игрока, при условии, что AutoSort.Periodic.Enable равно 1.
#        По умолчанию:     60

AutoSort.Periodic.Interval = 60

#
#    AutoSort.Periodic.SkipIfLooting
#        Описание: Пропускайте цикл периодической сортировки, если у игрока
#                  открыто окно добычи, чтобы избежать перетасовки содержимого
#                  сумок в процессе сбора лута.
#        По умолчанию:     1 (Включенно)

AutoSort.Periodic.SkipIfLooting = 1

#
#    AutoSort.Periodic.SkipInCombat
#        Описание: Пропускать цикл периодической сортировки, 
#                  пока игрок находится в бою.
#        По умолчанию:     1 (Включенно)

AutoSort.Periodic.SkipInCombat = 1

#
#    AutoSort.Periodic.SortBank
#        Описание: Также включайте банковские мешки в процесс периодической сортировки.
#        По умолчанию:     0 (Выключенно)

AutoSort.Periodic.SortBank = 0

#
#    AutoSort.Periodic.Message
#        Описание: Выводить сообщение при выполнении периодической сортировки,
#                  чтобы игрок был в курсе этого действия.
#        По умолчанию:     "" (пусто, сообщение отсутствует)

AutoSort.Periodic.Message = ""