[worldserver]

###################################################################################################
# Настройки модуля ProfessionProgression
###################################################################################################
#
# Прогрессивная система слотов для основных профессий с ограничениями уровня навыка, соответствующими версиям Vanilla, TBC и Wrath.
#
# Список доступных основных профессий по версиям игры:
#   Vanilla = 9 профессий: Алхимия, Кузнечное дело, Наложение чар, Инженерное дело, Травничество,
#               Кожевничество, Горное дело, Снятие шкур, Портняжное дело.
#   TBC     = 10 профессий: Vanilla + Ювелирное дело.
#   Wrath   = 11 профессий: TBC + Начертание.
#
# Прогрессия слотов:
#   - Игроки начинают с 2 слотами для основных профессий.
#   - Если уровень двух имеющихся профессий достигает 75 -> открывается 3-й слот.
#   - Если уровень двух имеющихся профессий достигает 150 -> открывается 4-й слот.
#   - Уровень дополнительных профессий не может превышать уровень меньшей из двух предыдущих профессий.
#   - Когда профессии №3 и №4 достигают максимального уровня для текущей версии игры -> открываются №5 и №6.
#   - Когда профессии №5 и №6 достигают максимального уровня для текущей версии игры -> открываются №7 и №8, и так далее.
#
# Этот модуль не удаляет изученные профессии и не отменяет стандартные требования к уровням навыка при обучении у тренеров.
###################################################################################################

ProfessionProgression.Enable = 1
ProfessionProgression.Announce = 1
ProfessionProgression.Debug = 0

# Эра профессий / ограничение прогресса.
# 0 = Vanilla: предел 300, только 9 классических профессий.
# 1 = TBC:     предел 375, Ювелирное дело доступно, если включена опция AutoExpansionProfessions.
# 2 = Wrath:   предел 425 (по умолчанию), Начертание доступно, если включена опция AutoExpansionProfessions.
#
# Для вашего сервера с ограничением уровня Classic оставьте значение 0.
ProfessionProgression.ExpansionStage = 0

# Ограничения по эпохам. Вы просили, чтобы логика для уровней 375 и 425 уже существовала,
# хотя никто не должен их достигать, пока доступ к дополнениям ограничен.
ProfessionProgression.VanillaSkillCap = 300
ProfessionProgression.TbcSkillCap = 375
ProfessionProgression.WrathSkillCap = 425

# Ручное переопределение. 0 = использовать лимит из параметра ExpansionStage (указанного выше).
# Пример: установите значение 450, если позже решите, что в Wrath должен использоваться стандартный лимит из оригинальной версии WotLK.
ProfessionProgression.MaxSkillCap = 0

# Стандартные основные слоты до разблокировки по мере прогресса.
ProfessionProgression.BaseSlots = 2

# Автоматически устанавливать максимальное количество слотов, доступных для разблокировки,
# в соответствии с числом профессий, активных в данной эпохе:
# Vanilla — 9, TBC — 10, Wrath — 11.
ProfessionProgression.AutoMaxPrimarySlots = 1

# Используется только в том случае, если AutoMaxPrimarySlots = 0.
ProfessionProgression.MaxPrimarySlots = 9

# Автоматически включать ювелирное дело в TBC и начертание в Wrath.
ProfessionProgression.AutoExpansionProfessions = 1

# Ручное переключение профессий. Используется только если AutoExpansionProfessions = 0.
ProfessionProgression.IncludeJewelcrafting = 0
ProfessionProgression.IncludeInscription = 0

# Первый дополнительный слот открывается, когда две основные профессии игрока с наивысшим уровнем достигают этого значения.
ProfessionProgression.UnlockThirdAt = 75

# Четвертый слот открывается, когда две основные профессии игрока с наивысшим уровнем достигают этого значения.
ProfessionProgression.UnlockFourthAt = 150

# После первых четырех слотов каждая освоенная пара открывает следующую пару.
# 0 = использовать ограничение навыка, соответствующее текущей эпохе: 300 / 375 / 425.
# Пример: в версии Vanilla, если навыки в слотах №3 и №4 достигли 300, открываются слоты №5 и №6.
ProfessionProgression.PairUnlockAt = 0
