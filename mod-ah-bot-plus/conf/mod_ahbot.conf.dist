###############################################################################
#    AuctionHouseBot.PriceMinimumCenterBase.UseItemSellPriceIfHigher
#        Если установлено значение true, то в качестве минимальной базовой цены будет использоваться цена
#        продажи предмета, указанная в столбце `SellPrice` таблицы `item_template`
#        (при условии, что она выше значения `PriceMinimumCenterBase`, заданного ниже).
#        Как правило, этот параметр следует оставлять включенным (true), так как минимальные цены были
#        введены лишь для того, чтобы отсеивать предметы с нулевой или крайне низкой стоимостью.
#        Если же установить значение false, то для всех предметов базовой ценой (до применения формул) станет цена,
#        установленная для данной категории; поэтому отключать этот параметр (false)
#        рекомендуется только в том случае, если вы настраиваете цены для каждого предмета индивидуально.
#        Примечание: Учитывайте также параметр BuyoutBelowVendorVariationAddPercentEnabled.
#
#    AuctionHouseBot.PriceMinimumCenterBase.*
#        Минимальные цены на уровне категории (в меди), действующие до применения каких-либо множителей.
#        Значение не должно быть нулевым в качестве базовой минимальной цены используются переменные
#        `BidVariation`, указанные выше.
#        Этот механизм служит для выявления предметов с нулевой или экстремально низкой стоимостью.
#        Обратите внимание: значение не может быть меньше 1.
#
#    AuctionHouseBot.PriceMinimumCenterBase.OverrideItems
#        Список элементов, разделенных запятыми, в формате «itemID:PriceMinCopper»
#        это значение переопределяет параметр PriceMinimumCenterBase и используется
#        до применения модификаций, зависящих от вариации и множителей.
#	 Пример: «2589:1000000,4306:100000» установит минимальную базовую цену льняной ткани
#	 на уровне 100 золотых, а шелковой — 10 золотых за штуку.
###############################################################################

AuctionHouseBot.PriceMinimumCenterBase.UseItemSellPriceIfHigher = true

AuctionHouseBot.PriceMinimumCenterBase.Consumable = 1000
AuctionHouseBot.PriceMinimumCenterBase.Container = 1000
AuctionHouseBot.PriceMinimumCenterBase.Weapon = 1000
AuctionHouseBot.PriceMinimumCenterBase.Gem = 1000
AuctionHouseBot.PriceMinimumCenterBase.Armor = 1000
AuctionHouseBot.PriceMinimumCenterBase.Reagent = 1000 
AuctionHouseBot.PriceMinimumCenterBase.Projectile = 5
AuctionHouseBot.PriceMinimumCenterBase.TradeGood = 850
AuctionHouseBot.PriceMinimumCenterBase.Generic = 1000
AuctionHouseBot.PriceMinimumCenterBase.Recipe = 1000
AuctionHouseBot.PriceMinimumCenterBase.Quiver = 1000
AuctionHouseBot.PriceMinimumCenterBase.Quest = 1000
AuctionHouseBot.PriceMinimumCenterBase.Key = 1000
AuctionHouseBot.PriceMinimumCenterBase.Misc = 1000
AuctionHouseBot.PriceMinimumCenterBase.Glyph = 1000

AuctionHouseBot.PriceMinimumCenterBase.OverrideItems = 

###############################################################################
#    AuctionHouseBot.AdvancedPricing.<Category>.<Subclass>.Enabled
#        Включение или отключение использования продвинутых (логарифмических) формул
#        ценообразования для определенных подклассов предметов. Этот механизм призван приблизить
#        систему ценообразования к той, что действует на официальных серверах.
#        В целом, цены на многие предметы становятся более «реалистичными», однако стоимость особо ценных товаров
#        (например, «Черного лотоса» или «Кожи дьявозавра») слишком аномальна, чтобы ее можно было точно рассчитать
#        по тем же правилам, что и для более предсказуемых предметов,
#        — в результате такие цены могут казаться заниженными.
#
#        Для помощи в изменении параметров конфигурации воспользуйтесь электронной
#        таблицей Advanced_Pricing_Calculator, которая находится в папке «tools» данного модуля.
#
#        Обратите внимание, что логика AdvancedPricing также опирается на значения,
#        заданные параметрами AuctionHouseBot.PriceMultiplier.Category*.Quality*. 
#    Defaults: true (включенно)
#
#    Обратите внимание, что все множители цены (включая параметры расширенного ценообразования)
#    применяются мультипликативно.
#    Пример: множители «Категория» (1,5x), «Качество» (2x) и «Категория/Качество» (1,4x)
#    в совокупности дают итоговый множитель 4,2 (1,5 × 2 × 1,4).
#    Параметры расширенного ценообразования (см. ниже) затем дополнительно умножают полученное значение.
#    Активация расширенного ценообразования отключает применение множителя PriceMultiplier.ItemLevel для данной категории.
###############################################################################

AuctionHouseBot.AdvancedPricing.Consumable.Potion.Enabled       = true
AuctionHouseBot.AdvancedPricing.Consumable.Elixir.Enabled       = true
AuctionHouseBot.AdvancedPricing.Consumable.Flask.Enabled        = true
AuctionHouseBot.AdvancedPricing.Gem.Enabled                     = true
AuctionHouseBot.AdvancedPricing.TradeGood.Cloth.Enabled         = true
AuctionHouseBot.AdvancedPricing.TradeGood.Herb.Enabled          = true
AuctionHouseBot.AdvancedPricing.TradeGood.MetalStone.Enabled    = true
AuctionHouseBot.AdvancedPricing.TradeGood.Leather.Enabled       = true
AuctionHouseBot.AdvancedPricing.TradeGood.Enchanting.Enabled    = true
AuctionHouseBot.AdvancedPricing.TradeGood.Elemental.Enabled     = true
AuctionHouseBot.AdvancedPricing.TradeGood.Meat.Enabled          = true
AuctionHouseBot.AdvancedPricing.Misc.Junk.Enabled               = true
AuctionHouseBot.AdvancedPricing.Misc.Mount.Enabled              = true
AuctionHouseBot.AdvancedPricing.Misc.Pet.Enabled                = true

###############################################################################
#    AuctionHouseBot.PriceMultiplier.Category.*
#    AuctionHouseBot.PriceMultiplier.Quality.*
#        Значения модификаторов категории или уровня качества для цен на предметы
#        они могут быть представлены в виде десятичных чисел и должны быть больше нуля.
#        Следует учитывать, что алгоритм ценообразования состоит из множества этапов,
#        а данный параметр — это лишь модификатор для тонкой настройки.
#
#    AuctionHouseBot.PriceMultiplier.ItemLevel.Category.*
#        Множитель, применяемый к уровню предмета при определении цены на аукционе (в зависимости от категории).
#        Итоговый множитель = уровень предмета × это значение. Установите значение 0 (или меньше), чтобы отключить эту функцию.
#        По умолчанию: 0 (отключено)
#       Примечание: этот параметр будет игнорироваться для любой соответствующей конкретной категории,
#       если включена функция AdvancedPricing (см. выше).
#       Он применяется в сочетании со всеми остальными ценовыми множителями.
#
#    AuctionHouseBot.PriceMultiplier.Category*.Quality*
#        Значения модификаторов «Категория» и «Качество» для цен на предметы.
#        Эти значения могут быть представлены в виде десятичных чисел и должны быть больше 0.
#        Это обеспечивает более точное управление, чем использование только параметров Category.*
#        или Quality.*: например, можно сделать необычное (uncommon) оружие дороже,
#        не затрагивая при этом необычные торговые товары.
#
#    Обратите внимание, что все ценовые множители (включая параметры расширенного ценообразования)
#    применяются мультипликативно.
#    Пример: множители «Категория» (1,5x), «Качество» (2x) и «Категория/Качество» (1,4x) в совокупности
#    дают итоговый множитель 4,2 (1,5 × 2 × 1,4). Параметры расширенного ценообразования (описанные выше)
#    затем дополнительно умножаются на полученное значение.
###############################################################################

# Broad category multipliers
AuctionHouseBot.PriceMultiplier.Category.Consumable = 1
AuctionHouseBot.PriceMultiplier.Category.Container = 1
AuctionHouseBot.PriceMultiplier.Category.Weapon = 1
