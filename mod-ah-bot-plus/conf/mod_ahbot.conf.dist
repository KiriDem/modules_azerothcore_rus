[worldserver]

###################################################################################################
# ИГРОВЫЕ КОМАНДЫ БОТА АУКЦИОННОГО ДОМА
#
#    Доступные команды GM:
#        .ahbot reload  - Перезагрузка конфигурации AuctionHouseBotn
#        .ahbot empty   - Очищает все аукционы AuctionHouseBot
#        .ahbot update  - Принудительно запускает цикл немедленного обновления
###################################################################################################

###############################################################################
# НАСТРОЙКИ АУКЦИОННОГО БОТТА
#    AuctionHouseBot.DEBUG
#        Включение/отключение вывода отладочной информации
#    По умолчанию: false (отключено)
#
#    AuctionHouseBot.DEBUG_FILTERS
#        Включение/отключение отладочного вывода из фильтров
#    По умолчанию: false (отключено)
#
#    AuctionHouseBot.MinutesBetweenBuyCycle
#        Сколько минут нужно подождать, прежде чем снова делать ставки/покупать товары.
#        Значение может быть одним числом, чтобы указать, что нужно подождать X минут перед покупкой
#        снова, или пара чисел, разделенных двоеточием, чтобы дождаться случайного числа
#        количество минут между X и Y (например, 3:15, чтобы подождать 3-15 минут)
#        между циклами).
#    По умолчанию: 1
#
#    AuctionHouseBot.MinutesBetweenSellCycle
#        Сколько минут нужно подождать, прежде чем снова продавать товары.
#        Значение может быть одним числом, чтобы подождать X минут перед продажей
#        снова, или пара чисел, разделенных двоеточием, чтобы дождаться случайного числа 
#        количество минут между X и Y (например, 3:15, чтобы подождать 3-15 минут
#        между циклами).
#    По умолчанию: 1
#
#    AuctionHouseBot.EnableSeller
#        Включение/отключение части AHBot, отвечающей за размещение товаров на аукционе
#    По умолчанию: false (отключено)
#
#    AuctionHouseBot.ReturnExpiredAuctionItemsToBot
#        Если включено (true), возвращает истекшие аукционные лоты боту(ам) аукционного дома через
#        почту. Примечание: если эта функция включена, почтовый ящик вашего бота может переполниться
#        # если вы не управляете этим вручную. Это также может повлиять на размер вашей
#        таблицы базы данных, acore_characters.item_instance будет расти со временем.
#    По умолчанию: false (отключено)
#
#    AuctionHouseBot.GUIDs
#        Это GUID персонажей (из таблицы characters) которые
#        будет использоваться для создания аукционов и любого другого взаимодействия с аукционами.
#        Это может быть одно значение или несколько значений, разделенных символом
#        запятая (без пробелов!). Примечание: GUID "0" будет проигнорирован!
#        Важно: Не используйте ботов (например, ботов-игроков ).
#        Это скорее всего, приведет к сбою сервера.
#    Примеры:
#        AuctionHouseBot.GUIDs = 3 <- Только персонаж с GUID 3
#        AuctionHouseBot.GUIDs = 3,4 <- Оба персонажа имеют GUID 3 и 4
#
#    AuctionHouseBot.ItemsPerCycle
#        Сколько предметов выставлять на аукцион при каждом обновлении аукциона.
#        Задания в рамках цикла будут размещаться случайно выбранным ботом.
#    По умолчанию 150
#
#    AuctionHouseBot.ListingExpireTimeInSecondsMin
#    AuctionHouseBot.ListingExpireTimeInSecondsMax
#        Время размещения объявлений на аукционах, проводимых ботами, будет находиться в диапазоне этих двух значений,
#        и важно, чтобы аукционный дом ощущал динамичность во времени проведения
#    По умолчанию 900 (15 минут), до 86400 (24часов)
#		 Примечание: Не устанавливайте значение меньше 15 минут (900) или больше 48 часов (172800)
###############################################################################

AuctionHouseBot.DEBUG = false
AuctionHouseBot.DEBUG_FILTERS = false
AuctionHouseBot.MinutesBetweenBuyCycle = 1
AuctionHouseBot.MinutesBetweenSellCycle = 1
AuctionHouseBot.EnableSeller = false
AuctionHouseBot.ReturnExpiredAuctionItemsToBot = false
AuctionHouseBot.GUIDs = 0
AuctionHouseBot.ItemsPerCycle = 150
AuctionHouseBot.ListingExpireTimeInSecondsMin = 900
AuctionHouseBot.ListingExpireTimeInSecondsMax = 86400

###############################################################################
#    AuctionHouseBot.CompleteItemValueOverride.Enabled
#        Включить/отключить возможность создания списка элементов, имеющих точное соответствие
#        значения цен, которые игнорируют любые другие вычисления, включая расширенное
#        ценообразование. Обратите внимание, что " AuctionHouseBot.Buyer." по-прежнему учитывается.
#    По умолчанию: false (отключено)
#
#    AuctionHouseBot.CompleteItemValueOverride.Items
#        Разделённый запятыми список товаров в формате "itemID:PriceMinCopper"
#        это точные цены товаров, не учитывающие никаких факторов
#        никаких математических вычислений при расчете цены товара.
#	 Пример: "2589:1000000,4306:100000" установит значение фиксированной цены
#      льняной ткани — 100 золотых, шелковой ткани — по 10 золотых каждая.
#    По умолчанию: 
#
#    AuctionHouseBot.CompleteItemValueOverride.DoApplyBidVariations
#    AuctionHouseBot.CompleteItemValueOverride.DoApplyBuyoutVariations
#        Если true, то переменные, такие как BuyoutVariation* и BidVariation*, будут иметь значение.
#        Приведенные ниже цены будут применяться к ценам, установленным параметром CompleteItemBuySellPriceOverride
#    По умолчанию: false (отключено)
###############################################################################

AuctionHouseBot.CompleteItemValueOverride.Enabled = false
AuctionHouseBot.CompleteItemValueOverride.Items = 
AuctionHouseBot.CompleteItemValueOverride.DoApplyBidVariations = false
AuctionHouseBot.CompleteItemValueOverride.DoApplyBuyoutVariations = false

###############################################################################
#    AuctionHouseBot.AdvancedListingRules.UseDropRates.Enabled
#        Включение/отключение продавца, использующего внутриигровые шансы выпадения предметов из врагов
#        и игровые объекты, чтобы определить вероятность их размещения на аукционе.
#        Это приводит к тому, что редкие предметы реже появляются на аукционе.
#        Как это работает: Каждый раз, когда выбирается категория/качество товара, доступного для размещения на аукционе
#        Выпадает число от 0 до 100. На основании этого броска выбирается уровень (Tier).
#        Используйте UseDropRates.TiersConfig, тогда на аукционе будет выставлен случайный предмет из этого уровня редкости.
#        Этот параметр учитывает конфигурацию ListProportion. Он также может привести к увеличению количества дубликатов
#        предметов, появляющимся на аукционе из-за более высокой вероятности выпадения, выбираются чаще.
#        Созданные предметы также могут появляться чаще, поскольку вероятность их выпадения составляет фактически 100%.
#    По умолчанию: false (отключено)
#
#    AuctionHouseBot.AdvancedListingRules.UseDropRates.<Category>
#        Переключить поведение AdvancedListingRules.UseDropRates для отдельных категорий.
#        Применяется только в том случае, если AdvancedListingRules.UseDropRates.Enabled имеет значение true.
#    По умолчанию: true (включенно)
#
#    AuctionHouseBot.AdvancedListingRules.UseDropRates.<Category>.AffectedQualities
#        На какие характеристики должно влиять свойство AdvancedListingRules.UseDropRates.
#        Значение должно представлять собой строку чисел, разделенных запятыми, соответствующих желаемым характеристикам.
#        Примеры: Значение 2, 3, 5 будет применяться к предметам категорий Необычные, Редкие и Легендарные.
#          Значение 4 будет применяться только к Эпическому.
#        (0) Серые, (1) Обычный, (2) Необычные, (3) Редкие, (4) Эпические, (5) Легендарные, (6) Семейная реликвия
#    По умолчанию: 2,3,4,5
#
#    AuctionHouseBot.AdvancedListingRules.UseDropRates.MinDropRate
#        Минимальная вероятность выпадения любого затронутого предмета.
#        У некоторых предметов в базе данных может быть крайне низкая вероятность выпадения (например, 0,00006), поэтому
#        эта настройка повысит вероятность выпадения этих предметов до указанного значения.
#    По умолчанию: 0.005
#
#    AuctionHouseBot.AdvancedListingRules.UseDropRates.TiersConfig
#        Пороговые значения, определяющие уровни вероятности выпадения предметов.
#        Значение должно представлять собой строку чисел от 0 до 100, разделенных запятым.
#        Каждое число обозначает категорию предметов, вероятность выпадения которых находится в этом диапазоне.
#        Порядок чисел в строке не обязательно должен быть отсортирован; они будут отсортированы
#        интерпретация ведется в порядке убывания. Однако, возможно, вам будет проще читать, если данные отсортированы.
#        Пробелы также игнорируются.
#        Пример: Установка значений 50, 10, 5 создаст 3 уровня:
#          - 50–100%: предметы с вероятностью выпадения 50% или выше
#          - 10–50%: предметы с вероятностью выпадения от 10% до 50%
#          - 0–5%: предметы с вероятностью выпадения 0–5%
#    По умолчанию: 50, 10, 5, 2, 1, 0.5, 0.2, 0.1, 0.05, 0.02, 0.01, 0.005
#
#    AuctionHouseBot.AdvancedListingRules.UseDropRates.DisabledItemIDs
#        Разделенный запятыми список идентификаторов предметов, которые следует исключить из списка предметов,
#        на вероятность выпадения которых влияет их доступность на аукционе.
#        Диапазоны, обозначенные дефисом (-), также можно использовать.
###############################################################################

AuctionHouseBot.AdvancedListingRules.UseDropRates.Enabled = false

AuctionHouseBot.AdvancedListingRules.UseDropRates.Weapon = true
AuctionHouseBot.AdvancedListingRules.UseDropRates.Armor  = true
AuctionHouseBot.AdvancedListingRules.UseDropRates.Recipe = true

AuctionHouseBot.AdvancedListingRules.UseDropRates.Weapon.AffectedQualities = 2,3,4,5
AuctionHouseBot.AdvancedListingRules.UseDropRates.Armor.AffectedQualities  = 2,3,4,5
AuctionHouseBot.AdvancedListingRules.UseDropRates.Recipe.AffectedQualities = 2,3,4,5

AuctionHouseBot.AdvancedListingRules.UseDropRates.MinDropRate = 0.005
AuctionHouseBot.AdvancedListingRules.UseDropRates.TiersConfig = 50, 10, 5, 2, 1, 0.5, 0.2, 0.1, 0.05, 0.02, 0.01, 0.005
AuctionHouseBot.AdvancedListingRules.UseDropRates.DisabledItemIDs = 

###############################################################################
#    AuctionHouseBot.MaxBuyoutPriceInCopper
#        Максимальная сумма, которую можно выкупить при размещении акций на бирже, в меди. 
#        Предотвращает переполнение. Не увеличивайте это значение, но можете уменьшить.
#    По умолчанию 1000000000 (100 тыс. золота)
#
#    AuctionHouseBot.BuyoutVariationReducePercent
#    AuctionHouseBot.BuyoutVariationAddPercent
#        После расчета цены с использованием различных множителей для каждого из вариантов 
#        покупка или продажа, результат выбирается случайным образом в диапазоне до + AddPercent
#        и до -ReducePercent
#    Значение по умолчанию 0,15 (вниз) и 0,25 (вверх) - это означает диапазон цен -15% или +25%
#        Значение по умолчанию 0,15 (вниз) и 0,25 (вверх) - это означает диапазон цен -15% или +25%
#        Установка обоих значений равными 0 приведет к отсутствию каких-либо изменений цен
#
#    AuctionHouseBot.BidVariationHighReducePercent
#    AuctionHouseBot.BidVariationLowReducePercent
#        После расчета суммы выкупа, вот насколько глубже происходит выкуп
#        Цена предложения может варьироваться от «выкуп с высоким снижением» до «выкуп с низким снижением»
#        процентов
#    По умолчанию 0 (выс. ставка) и 0,25 (низ. ставка) - Начальная ставка будет равна выкупу (выс. ставка) и выкупу за вычетом 25% (низ. ставка)
#        Примечание: Не устанавливайте отрицательные значения ни для одного из чисел. Установите оба значения равными 0,
#        если хотите получать точные суммы выкупа как для покупателя, так и для продавца.
#
#    AuctionHouseBot.BuyoutBelowVendorVariationAddPercentEnabled
#        Если true, при расчете цены будет применяться следующий процент конфигурации
#        цена выкупа рассчитывается ниже значения item_template.SellPrice
#    По умолчанию: true
#
#    AuctionHouseBot.BuyoutBelowVendorVariationAddPercent
#        Если в результате сделки цена выкупа окажется ниже цены продавца
#        добавьте к этому, чтобы поднять цену выше цены поставщика.
#    Значение по умолчанию 0,25 (+25% увеличение цены)
#	     Примечание: Не указывайте отрицательное значение, иначе товар будет продаваться хуже, чем у продавца.
#        Установите значение на 0, если вам нужна точная цена поставщика
###############################################################################

AuctionHouseBot.MaxBuyoutPriceInCopper = 1000000000
AuctionHouseBot.BuyoutVariationReducePercent = 0.15
AuctionHouseBot.BuyoutVariationAddPercent = 0.25
AuctionHouseBot.BidVariationHighReducePercent = 0
AuctionHouseBot.BidVariationLowReducePercent = 0.25
AuctionHouseBot.BuyoutBelowVendorVariationAddPercentEnabled = true
AuctionHouseBot.BuyoutBelowVendorVariationAddPercent = 0.25

###############################################################################
#    AuctionHouseBot.<faction>.MinItems
#    AuctionHouseBot.<faction>.MaxItems
#        Минимальное и максимальное количество товаров, которые можно выставить на аукцион в данном аукционном доме
#    Примечание: Если в вашем файле AzerothCore включена опция AllowTwoSide.Interaction.Auction
#        worldserver.conf, тогда отобразится только нейтральный AH для заполнени
#        базы данных. Аукционы по-прежнему будут отображаться на не нейтральных аукционах.
#    По умолчанию: 15000 для обоих вариантов
###############################################################################

AuctionHouseBot.Alliance.MinItems = 15000
AuctionHouseBot.Alliance.MaxItems = 15000
AuctionHouseBot.Horde.MinItems = 15000
AuctionHouseBot.Horde.MaxItems = 15000
AuctionHouseBot.Neutral.MinItems = 15000
AuctionHouseBot.Neutral.MaxItems = 15000

###############################################################################
# НАСТРОЙКИ ПОКУПАТЕЛЯ
#    Поведение: 
#     1) Определение товаров для покупки: Каждую минуту бот-покупатель будет выбирать товары 
#        (BuyCandidatesPerBuyCycle) товаров, выставленных в настоящее время на аукцион, которые являются
#        перечислены игроками как потенциальные товары для покупки.
#     2) Цена, которую покупатель готов заплатить: бот-покупатель будет использовать ту же цену товара 
#        расчет, используемый ботом продавца, включая случайные +/- 25% 
#        (настраивается параметром BuyoutVariationAddPercent ), и эта рассчитанная цена
#        Затем умножается на ( AcceptablePriceModifier ), в результате чего получается
#        цена, которую покупатель готов заплатить.
#     3) Покупка: Если рассчитанная цена выше цены выкупа,
#        тогда бот его выкупит. Если нет, он проверит, является ли это товаром
#        Если на этот товар еще не сделали ставку бота, и цена приемлемая, то он будет выставлен на продажу 
#        сделать ставку (перебить ставку, то есть немного превысить текущую ставку)
#     - Описанное выше поведение воспроизводится на каждом включенном аукционном доме.
#     - Если оставить настройки по умолчанию, в каждом аукционном доме будет предпринята попытка выставить только один лот
#       у кого следует совершить покупку, если расчет цены кажется выгодным.
#     - Обратите внимание, что любая попытка покупки товара, даже товара по цене выше закупочнойe, 
#       использует потенциальный объект для покупки. Это означает, что слишком много товаров имеют завышенную цену 
#       и может заглушить потенциальные продажи.
#
#    AuctionHouseBot.Buyer.Enabled
#        Включение/отключение бота для покупок.
#    По умолчанию: false (отключено)
#
#    AuctionHouseBot.Buyer.BuyCandidatesPerBuyCycle
#        Сколько товаров нужно оценить и попытаться купить. Обратите внимание, это количество
#        товаров будут отобраны из каждого типа аукционных домов (Альянс,
#        Орда, Нейтральный). То есть, если вы установите значение 10, то можно использовать до 10 предметов
#        Из каждого AH будет выбрано (всего 30). Только целые числа.
#        Очень большие значения могут повлиять на производительность сервера и необязательны.
#        Эта команда выполняется один раз за каждый цикл покупки/продажи, как определено
#        от AuctionHouseBot.AuctionHouseManagerCyclesBetweenBuyOrSell.
#        Значение может быть представлено одним числом, чтобы можно было рассмотреть возможность покупки X товаров по отдельности
#        Цикл покупки/продажи, или пара чисел, разделенны ':'
#        Покупка случайного количества товаров в диапазоне от X до Y. (например, 1:5 для учета от 1 до 5 товаров)
#    По умолчанию: 1 (1 лот от аукционного дома считается за цикл купли/продажи)
#
#    AuctionHouseBot.Buyer.AcceptablePriceModifier
#        Бот-покупатель рассчитывает цену товара так же, как и бот-продавец,
#        а затем умножает полученное значение на этот коэффициент, чтобы определить сумму,
#        которую он готов потратить. Значение 1 означает, что бот-покупатель в целом
#        будет платить столько же, сколько запрашивает бот-продавец.
#        Аналогичным образом, значение 1,5 означает, что он заплатит примерно на 50% больше цены,
#        установленной ботом-продавцом. Этот коэффициент может быть меньше 1, если вы хотите,
#        чтобы покупатель был более прижимистым (значение 0,5 означает,
#        что покупатель заплатит до 50% от цены продавца), однако он не должен быть ниже 0.
#    По умолчанию: 1
#
#    AuctionHouseBot.Buyer.AlwaysBidMaxCalculatedPrice
#        При активации этой функции бот для покупок будет использовать рассчитанную максимальную цену,
#        которую покупатель готов был заплатить, в качестве суммы своей ставки — вместо минимально возможной суммы ставки.
#    По умолчанию: false
#
#    AuctionHouseBot.Buyer.PreventOverpayingForVendorItems
#        Если эта функция включена, бот-покупатель не будет приобретать на аукционе предметы по цене,
#        превышающей стоимость их продажи торговцу. Это предотвращает попытки игроков
#        манипулировать экономикой путем перепродажи товаров, купленных у торговцев.
#        Если функция отключена, бот может покупать такие товары по завышенной цене,
#        если она укладывается в установленные правила допустимых ценовых коэффициентов.
#    По умолчанию: true
#
#    AuctionHouseBot.Buyer.BidAgainstPlayers
#        При активации бот-покупатель будет делать ставки на аукционах, в которых участвуют игроки,
#        — в пределах допустимого ценового диапазона, установленного для этого бота.
#    По умолчанию: false
###############################################################################

AuctionHouseBot.Buyer.Enabled = false
AuctionHouseBot.Buyer.BuyCandidatesPerBuyCycle = 1
AuctionHouseBot.Buyer.AcceptablePriceModifier = 1
AuctionHouseBot.Buyer.AlwaysBidMaxCalculatedPrice = false
