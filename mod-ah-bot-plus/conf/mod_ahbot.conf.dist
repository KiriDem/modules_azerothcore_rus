###############################################################################
#    AuctionHouseBot.ListedItemLevelRestrict.Enabled
#        Если значение true, то уровень товара будет ограничен в списках
#    По умолчанию: false
#
#    AuctionHouseBot.ListedItemLevelRestrict.MinItemLevel
#        Самый низкий уровень товара, который будет отображаться в списках
#    По умолчанию: 0
#
#    AuctionHouseBot.ListedItemLevelRestrict.UseCraftedItemForCalculation
#        Если предмет является рецептом, то будет использован предмет, созданный по этому рецепту.
#        для определения, будет ли он исключен
#    По умолчанию: true
#
#    AuctionHouseBot.ListedItemLevelRestrict.MaxItemLevel
#        Самый высокий уровень товара, который будет отображаться в списках
#    По умолчанию: 999
#
#    AuctionHouseBot.ListedItemLevelRestrict.ExceptionItemIDs
#        Разделенный запятыми список ID товаров (itemID), которые следует исключить из любой логики ограничений на уровне товара
#        Диапазоны, обозначенные дефисом (-), также можно использовать
#        ПРИМЕЧАНИЕ: Другие фильтры будут по-прежнему учитываться, даже если они указаны здесь.
# 		 Пример: "2589,3200-3202" приведет к получению льняной ткани (2589) и наручей из обожженной кожи (3200).
#        Боевой топор варвара (3201) и кожаные наручи из леса (3202) не должны
#        подвергаться этому ограничению
###############################################################################

AuctionHouseBot.ListedItemLevelRestrict.Enabled = false
AuctionHouseBot.ListedItemLevelRestrict.UseCraftedItemForCalculation = true
AuctionHouseBot.ListedItemLevelRestrict.MinItemLevel = 0
AuctionHouseBot.ListedItemLevelRestrict.MaxItemLevel = 999
AuctionHouseBot.ListedItemLevelRestrict.ExceptionItemIDs = 

###############################################################################
#    AuctionHouseBot.EquipItemUseOrEquipLevelRestrict.Enabled
#        Если true, то логика, связанная с ограничением возможности бота отображать товары,
#        активена в зависимости от уровня экипировки или уровня использования. Обратите внимание, что предметы
#        без указания уровня экипировки или использования игнорируются в этой логике (всегда включаются)
#    По умолчанию: false
#
#    AuctionHouseBot.EquipItemUseOrEquipLevelRestrict.MinLevel
#        Самый низкий уровень экипировки или использования, который будет отображаться в списках. Предметы
#        Никакие уровни экипировки или использования не будут ограничены
#    По умолчанию: 0
#
#    AuctionHouseBot.EquipItemUseOrEquipLevelRestrict.MaxLevel
#        Максимальный уровень экипировки или использования, который будет отображаться в списках. Предметы
#        Никакие уровни экипировки или использования не будут ограничены
#    По умолчанию: 0
#
#    AuctionHouseBot.EquipItemUseOrEquipLevelRestrict.ExceptionItemIDs
#        Разделённый запятыми список ID предметов, которые следует исключить из логики ограничений по уровню экипировки или использования.
#        Диапазоны, обозначенные дефисом (-), также можно использовать
#        ПРИМЕЧАНИЕ: Другие фильтры будут по-прежнему учитываться, даже если они указаны здесь.
# 		 Пример: "2589,3200-3202" приведет к получению льняной ткани (2589) и наручей из обожженной кожи (3200).
# 		 Боевой топор варвара (3201) и кожаные наручи из леса (3202) не должны
# 		 подвергаться этому ограничению

###############################################################################

AuctionHouseBot.EquipItemUseOrEquipLevelRestrict.Enabled = false
AuctionHouseBot.EquipItemUseOrEquipLevelRestrict.MinLevel = 0
AuctionHouseBot.EquipItemUseOrEquipLevelRestrict.MaxLevel = 999
AuctionHouseBot.EquipItemUseOrEquipLevelRestrict.ExceptionItemIDs = 

###############################################################################
#    AuctionHouseBot.ListedItemIDRestrict.Enabled
#        Если true, IDs товаров ( item_temtplate.entry ) будут ограничены в списках
#    По умолчанию: false
#
#    AuctionHouseBot.ListedItemIDRestrict.MinItemID
#        ID товара с наименьшим значением, который будет отображаться в списках
#    По умолчанию: 0
#
#    AuctionHouseBot.ListedItemIDRestrict.MaxItemID
#        Наибольший ID товара, который будет отображаться в списках
#    По умолчанию: 200000
#
#    AuctionHouseBot.ListedItemIDRestrict.ExceptionItemIDs
#        Разделенный запятыми список идентификаторов товаров , которые следует исключить из логики ограничения по идентификаторам товаров.
#        Диапазоны, обозначенные дефисом (-), также можно использовать.
#       ПРИМЕЧАНИЕ: Другие фильтры будут по-прежнему учитываться, даже если они указаны здесь.
# 		Пример: "2589,3200-3202" приведет к получению льняной ткани (2589) и наручей из обожженной кожи (3200).
#        Боевой топор варвара (3201) и кожаные наручи из леса (3202) не должны
#        подвергаться этому ограничению
###############################################################################

AuctionHouseBot.ListedItemIDRestrict.Enabled = false
AuctionHouseBot.ListedItemIDRestrict.MinItemID = 0
AuctionHouseBot.ListedItemIDRestrict.MaxItemID = 200000
AuctionHouseBot.ListedItemIDRestrict.ExceptionItemIDs = 

###############################################################################
#    AuctionHouseBot.DisabledItemTextFilter
#        Если true, бот продавца не будет размещать товары с некорректными названиями, такими как "OLD" и " D'Sak"
#    По умолчанию: true
#
#    AuctionHouseBot.DisabledRecipeProducedItemFilterEnabled
#        Если true, бот продавца применит фильтрацию в DisabledRecipeProducedItemClassSubClasses
#    По умолчанию: false
#
#    AuctionHouseBot.DisabledRecipeProducedItemClassSubClasses
#        Разделённый запятыми список элементов в формате " класс:подкласс ", который
#        будет отфильтровано из объявлений бота продавца, если DisabledRecipeProducedItemFilterEnabled
#        истинно, и предмет изготовлен по рецепту. Значения берутся из
#        Переменные ITEM_CLASS_ и ITEM_SUBCLASS_ в AzerothCore 
#        (полный список см. в ItemTemplate.h). Можно использовать подстановочный знак (*) для
#        подкласса (но не может быть классом с подстановочными знаками).
#        По умолчанию: Отфильтровывает созданное игроком оружие (2:*), броню (4:*), питомцев (15:2) и ездовых животных (15:5)
#
#    AuctionHouseBot.DisabledInvalidItemIDs
#        Разделенный запятыми список идентификаторов товаров (itemID) , которые ботом продавца следует исключить из списка,
#        которые представляют собой элементы, которые в противном случае были бы непригодны для использования,
#        или элементы в базе данных, которые не являются
#        доступными на стандартном сервере Blizzard.
#        Диапазоны, обозначенные дефисом (-), также можно использовать.
#
#    AuctionHouseBot.DisabledCustomItemIDs
#        Разделенный запятыми список идентификаторов товаров (itemID) , которые ботом продавца следует исключить из списка,
#        которые представляют любые пользовательские идентификаторы, которые вы также хотите исключить.
#        По умолчанию пусто. Диапазоны, обозначенные дефисом (-), также можно использовать.
###############################################################################

