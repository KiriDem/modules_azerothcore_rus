##########################
#
# Масштабирование характеристик — Переопределение модификаторов характеристик
#
##########################
# Примечание касательно приоритетности настроек модификаторов характеристик: более конкретные значения ЗАМЕНЯЮТ менее конкретные.
# Боссы и обычные существа используют разные настройки, но действуют схожим образом.
#
# Пример Босса: Верховный жрец Веноксис (босс, CreatureID 14507) в рейде на 20 игроков «Зул'Гуруб» (InstanceID 309):
#
#     StatModifierRaid.Boss.Global=     0.7
#     StatModifierRaid20M.Boss.Global=  0.8
#     StatModifier.Boss.PerInstance=    "309 0.9"
#     StatModifier.PerCreature=         "14507 1.0"
#
# Настройки применяются сверху вниз, при этом нижняя настройка (1,0) применяется ко всем характеристикам босса.
# Если пропустить настройку «PerCreature», вместо неё будет применена настройка для конкретных экземпляров боссов Зул'Гуруба (0,9) и так далее.
#
# Пример не боса: Расплавленный великан (не босс, CreatureID 11658) в рейде «Огненные Недра» на 40 игроков (InstanceID 409):
#
#     StatModifierRaid.Damage =     2.1
#     StatModifierRaid40M.Damage =  2.2
#     StatModifier.PerInstance =    "409 -1 -1 -1 -1 2.3"
#     StatModifier.PerCreature=     "11658 -1 -1 -1 -1 2.4"
#
# Настройки применяются сверху вниз, причем нижняя настройка (2.4) применяется к множителю урона существа.
# Если пропустить настройку «PerCreature», вместо неё будет применена настройка для конкретного подземелья (инстанса),
# касающаяся урона от рядовых противников в «Огненных Недрах» (2.3), и так далее.
#
# Имейте в виду, что для любого конкретного параметра переопределения можно использовать значение «-1»; это позволит применить настройки более общего уровня.
#
# Таким образом, вы можете сделать конфигурации настолько простыми или сложными, насколько пожелаете: если вам нужно лишь задать общие модификаторы
# для подземелий и рейдов, всё будет работать как положено. Если же вы захотите настроить конкретных существ по своему усмотрению, это тоже возможно.
#
#
#     AutoBalance.StatModifier.PerInstance
#        Позволяет задавать значения модификаторов характеристик для конкретного экземпляра.
#        Указание значения `-1` означает, что переопределение данного параметра будет пропущено.
#        При желании можно опустить элементы в конце строки. Для каждого InstanceID следует указывать только один набор значений.
#
#        ДЕЙСТВУЕТ ТОЛЬКО НА СУЩЕСТВ, НЕ ЯВЛЯЮЩИХСЯ БОССАМИ.
#
#        Получите список ID подземелий здесь: https://wowpedia.fandom.com/wiki/InstanceID#Classic
#
#        Формат: "[InstanceID] [Global] [Health] [Mana] [Armor] [Damage] [CCDuration], [InstanceID] [Global] [Health] [Mana] [Armor] [Damage] [CCDuration], ..."
#
#        Пример: AutoBalance.StatModifier.PerInstance="409 1.0 0.8 0.8 1.0 1.2 1.0, 568 -1 -1 -1 -1 1.35, 43 -1 1.2 1.2"
#
#        По умолчанию: Пустая строка, отключающая эту функцию.
AutoBalance.StatModifier.PerInstance=""

#
#     AutoBalance.StatModifier.Boss.PerInstance
#        Позволяет задавать значения модификаторов характеристик отдельно для каждого подземелья (инстанса), но только для боссов.
#        Установка значения `-1` означает, что переопределение данного параметра выполняться не будет.
#        При желании можно опустить элементы в конце строки. Для каждого InstanceID следует указывать только один набор значений.
#
#        ДЕЙСТВУЕТ ТОЛЬКО НА БОССОВ.
#
#        Получите список ID подземелий здесь: https://wowpedia.fandom.com/wiki/InstanceID#Classic
#
#        Формат: "[InstanceID] [Boss.Global] [Boss.Health] [Boss.Mana] [Boss.Armor] [Boss.Damage] [Boss.CCDuration], [InstanceID] [Boss.Global] [Boss.Health] [Boss.Mana] [Boss.Armor] [Boss.Damage] [Boss.CCDuration], ..."
#
#        Пример: AutoBalance.StatModifier.Boss.PerInstance="409 1.0 0.8 0.8 1.0 1.2 0.8, 568 -1 -1 -1 -1 1.35, 43 -1 1.2 1.2"
#
#        По умолчанию: Пустая строка, отключающая эту функцию.
AutoBalance.StatModifier.Boss.PerInstance=""

#
#     AutoBalance.StatModifier.Boss.PerCreature
#        Позволяет задавать значения модификаторов характеристик для каждого существа.
#        Указание значения `-1` означает, что переопределение данного параметра будет пропущено.
#        При желании можно опустить элементы в конце строки. Для каждого CreatureID следует указывать только один набор значений.
#
#        Формат: "[CreatureID] [Global] [Health] [Mana] [Armor] [Damage] [CCDuration], [CreatureID] [Global] [Health] [Mana] [Armor] [Damage] [CCDuration], ..."
#
#        Пример: AutoBalance.StatModifier.Boss.PerInstance="14507 1.0 0.8 0.8 1.0 1.2 0.5, 11372 -1 -1 -1 -1 1.35, 43 -1 1.2 1.2"
#
#        По умолчанию: Пустая строка, отключающая эту функцию.
AutoBalance.StatModifier.PerCreature=""

#
#     AutoBalance.MinHPModifier
#        Минимальный множитель для изменения здоровья. Здоровье врага не будет умножаться на значение, меньшее этого.
#        По умолчанию:     0.01
AutoBalance.MinHPModifier=0.01

#
#     AutoBalance.MinManaModifier
#        Минимальный множитель для изменения маны. Мана врага не будет умножаться на значение, меньшее этого.
#        По умолчанию:     0.01
AutoBalance.MinManaModifier=0.01

#
#     AutoBalance.MinDamageModifier
#        Минимальный множитель для модификации урона. Урон противника не будет умножаться на значение, меньшее указанного.
#        По умолчанию:     0.01
AutoBalance.MinDamageModifier=0.01

#
#     AutoBalance.MinCCDurationModifier
#        Минимальный множитель для длительности эффектов контроля. Длительность эффекта контроля, наложенного на врага, не будет умножаться на значение, меньшее указанного.
#        По умолчанию:     0.25
AutoBalance.MinCCDurationModifier=0.25

#
#     AutoBalance.MaxCCDurationModifier
#        Настройка максимального множителя для длительности эффектов контроля.
#        Длительность эффекта контроля, наложенного на противника, не будет умножаться на значение, превышающее этот показатель.
#        По умолчанию:     1.0
AutoBalance.MaxCCDurationModifier=1.0

##########################
#
# Misc Settings
#
##########################

#
#     AutoBalance.ForcedIDXX
#        Устанавливает MobID для группы, к которой они принадлежат.
#        Все существа для 5 игроков должны быть указаны в параметре AutoBalance.ForcedID5=
#        Все существа для 10 игроков должны быть указаны в параметреAutoBalance.ForcedID10=
#        Все существа для Х игроков должны быть указаны в параметре AutoBalance.ForcedIDX=
AutoBalance.ForcedID40=""
AutoBalance.ForcedID25=""
AutoBalance.ForcedID20=""
AutoBalance.ForcedID10=""
AutoBalance.ForcedID5=""
AutoBalance.ForcedID2=""

#
#     AutoBalance.DisabledID
#        Отключить масштабирование для определенных существ
#
AutoBalance.DisabledID=""

##########################
#
# Масштабирование уровня
#
##########################

#
#     AutoBalance.LevelScaling
#        Масштабируйте существ в подземельях в зависимости от уровня игрока с самым высоким уровнем.
#        0 = Выключенно
#        1 = Включенно (только в подземельях/рейдах)
#        По умолчанию:     1
AutoBalance.LevelScaling=1

#
#     AutoBalance.LevelScaling.Method
#        Выбирает метод, который следует использовать при определении уровня масштабируемых существ.
#
#           fixed:
#               Уровень существ будет подстраиваться под уровень игрока с самым высоким уровнем в группе.
#
#           dynamic:
#               Уровень существ будет корректироваться с учетом двух факторов:
#                 1) их исходного уровня относительно самого сильного существа в инстансе
#                 2) уровня самого сильного игрока в подземелье.
#               Это означает, что рядовые противники низкого уровня по-прежнему будут слабее вас, а боссы высокого уровня — сильнее.
#
#        Возможные значения: "fixed" или "dynamic"
#
#        По умолчанию: "dynamic"
AutoBalance.LevelScaling.Method="dynamic"

#
#     AutoBalance.LevelScaling.SkipHigherLevels
#        Если средний уровень существ в инстансе превышает максимальный уровень игрока не более чем на (SkipHigherLevels) уровней, не понижайте их уровень.
#
#        Чтобы отключить понижение уровня инстанса, установите это значение равным максимальному уровню на вашем сервере (вероятно, 80).
#        Чтобы полностью отключить эту функцию и масштабировать все экземпляры более высокого уровня, установите это значение равным 0.
#
#        По умолчанию: 3
#
#     AutoBalance.LevelScaling.SkipLowerLevels
#        Если средний уровень существ в инстансе ниже максимального уровня игрока не более чем на (SkipLowerLevels) уровней,
#        масштабирование в сторону повышения не применяется.
#
#        Чтобы отключить масштабирование уровней инстанса вверх, установите это значение равным максимальному уровню на вашем сервере (вероятно, 80).
#        Чтобы полностью отключить эту функцию и масштабировать все экземпляры нижнего уровня, установите это значение равным 0.
#
#        По умолчанию: 5
AutoBalance.LevelScaling.SkipHigherLevels = 3
AutoBalance.LevelScaling.SkipLowerLevels = 5

#
#     AutoBalance.LevelScaling.DynamicLevel.Ceiling.*
#        Задает максимальное превышение уровня существ (масштабируемых в «динамическом» режиме) над уровнем игрока
#        с самым высоким показателем. Уровень существа в подземелье, имеющего изначально самый высокий уровень, будет установлен
#        равным уровню игрока с самым высоким уровнем плюс данное значение.
#
#        Действует только при условии, что AutoBalance.LevelScaling.Method = "dynamic"
#
#        По умолчанию: 1 (Dungeons), 2 (Heroic Dungeons), 3 (Raids), 3 (Heroic Raids)
#
#     AutoBalance.LevelScaling.DynamicLevel.Floor.*
#        Задает максимальную разницу в уровнях, на которую существа, масштабируемые в «динамическом» режиме,
#        могут отставать от игрока с самым высоким уровнем. Это позволяет удерживать разрыв в уровнях в разумных пределах
#        в тех случаях, когда игроки сильно различаются по уровню.
#
#        Действует только при условии, что AutoBalance.LevelScaling.Method = "dynamic"
#
#        По умолчанию: 5
AutoBalance.LevelScaling.DynamicLevel.Ceiling.Dungeons = 1
AutoBalance.LevelScaling.DynamicLevel.Floor.Dungeons = 5

AutoBalance.LevelScaling.DynamicLevel.Ceiling.HeroicDungeons = 2
AutoBalance.LevelScaling.DynamicLevel.Floor.HeroicDungeons = 5

AutoBalance.LevelScaling.DynamicLevel.Ceiling.Raids = 3
AutoBalance.LevelScaling.DynamicLevel.Floor.Raids = 5

AutoBalance.LevelScaling.DynamicLevel.Ceiling.HeroicRaids = 3
AutoBalance.LevelScaling.DynamicLevel.Floor.HeroicRaids = 5

#
#     AutoBalance.LevelScaling.DynamicLevel.PerInstance
#        Позволяет задавать параметры Dynamic Level для каждого экземпляра. Установка значения `-1` означает, что переопределение данного параметра выполняться не будет.
#        При желании можно опустить элементы в конце строки. Для каждого InstanceID следует указывать только один набор значений.
#        Установите значение "", чтобы отключить эту функцию.
#
#        Получите список ID подземелий здесь: https://wowpedia.fandom.com/wiki/InstanceID#Classic
#
#        Формат: "[InstanceID] [SkipHigherLevels] [SkipLowerLevels] [DynamicLevelCeiling] [DynamicLevelFloor], [InstanceID] [SkipHigherLevels] [SkipLowerLevels] [DynamicLevelCeiling] [DynamicLevelFloor], ..."
#
#        Пример: AutoBalance.StatModifier.PerInstance="409 -1 -1 0 3, 568 3, 43 -1 8"
#
#        По умолчанию: "229 -1 -1 1, 230 0 0" (Рекомендуемые корректировки)
#
# 229 - Вершина Черной горы
# 230 - Глубины Черной горы
AutoBalance.LevelScaling.DynamicLevel.PerInstance="229 -1 -1 1, 230 0 0"

#
#     AutoBalance.LevelScaling.DynamicLevel.DistanceCheck.PerInstance
#        Некоторые подземелья состоят из нескольких крыльев, объединенных одним идентификатором подземелья (InstanceID).
#        Для этих крыльев могут быть установлены различные требования к уровню. Вы можете настроить этот параметр для каждого подземелья отдельно,
#        чтобы при расчете его уровня учитывались только те существа, которые находятся в пределах заданного радиуса ([WorldUnits]) от любого из игроков.
#        Это позволит точнее определять уровень существ в подземельях, состоящих из нескольких крыльев.
#
#        ПРИМЕЧАНИЕ: Если два игрока из одной группы одновременно войдут в два разных крыла подземелья с одним и тем же InstanceID,
#                    уровни существ будут рассчитываться неверно до тех пор, пока один из этих игроков не покинет подземелье.
#
#        Получите список ID подземелий здесь: https://wowpedia.fandom.com/wiki/InstanceID#Classic
#
#        Формат: "[InstanceID] [WorldUnits]"
#
#        Пример: AutoBalance.LevelScaling.DynamicLevel.DistanceCheck.PerInstance="189 500, 624 250"
#
#        По умолчанию: "189 500" (Рекомендуемые корректировки)
#
# 189 - Алый монастырь
AutoBalance.LevelScaling.DynamicLevel.DistanceCheck.PerInstance="189 500"

##########################
#
# Масштабирование вознаграждения
#
##########################

#
#     AutoBalance.RewardScaling.Method
#        Задает метод, который будет использоваться при уменьшении количества опыта и денег в подземелье.
#
#           fixed:
#               Опыт и деньги будут делиться на максимальное количество игроков в группе, независимо от настроек масштабирования.
#               Каждый игрок получит рассчитанную таким образом сумму.
#
#           dynamic:
#               Количество опыта и денег будет масштабироваться в зависимости от модификаторов здоровья и урона, примененных к существу.
#               При расчете масштабирования награды также учитывается изменение уровня.
#
#               Если в результате масштабирования для существа установлен множитель опыта 0,65, то за него будет даваться 65% от того объема
#               опыта, который обычно полагается за существо соответствующего (измененного) уровня.
#
#               Если в результате масштабирования для существа установлен множитель денег 1,5, то за него будет даваться 150% от суммы
#               денег, которую оно приносило бы на своем исходном уровне с учетом масштабирования.
#
#               Опыт и деньги распределяются поровну между всеми игроками в подземелье.
#
#        Возможные значения: "fixed" or "dynamic"
#
#        По умолчанию: "dynamic"
AutoBalance.RewardScaling.Method="dynamic"

#
#     AutoBalance.RewardScaling.XP
#        Масштабируйте опыт (XP) в зависимости от выбора параметра `AutoBalance.RewardScaling.Method`.
#
#        По умолчанию: 1 (1 = ВКЛ, 0 = ВЫКЛ)
#
#     AutoBalance.RewardScaling.XP.Modifier
#        Примените фиксированный модификатор к количеству опыта, начисляемого игрокам.
#
#        Применяется только в том случае, если `AutoBalance.RewardScaling.XP` равно 1.
#
#        Если для `RewardScaling.XP.Modifier` установлено значение 1,5, а `RewardScaling` определяет, что каждому
#        игроку должно быть начислено 100 ед. опыта, то будет начислено 150 ед. опыта.
#
#        По умолчанию: 1.0 (без изменений)
AutoBalance.RewardScaling.XP = 1
AutoBalance.RewardScaling.XP.Modifier = 1.0

#
#     AutoBalance.RewardScaling.Money
#        Размер денежного вознаграждения (Money drops) корректируется в зависимости от настройки `AutoBalance.RewardScaling.Method`.
#        Если установлено значение 0, выдается полная сумма.
#
#        По умолчанию: 1 (1 = ВКЛ, 0 = ВЫКЛ)
#
#     AutoBalance.RewardScaling.Money.Modifier
#        Примените фиксированную модификацию к сумме денег, выдаваемой игрокам в качестве награды.
#
#        Применяется только в том случае, если `AutoBalance.RewardScaling.Money` равно 1.
#
#        Если для `RewardScaling.Money.Modifier` установлено значение 1,5, а `RewardScaling` определяет, что каждому игроку
#        полагается 1 золотой, то в качестве награды будет выдано 1 золото и 50 серебра.
#
#        По умолчанию: 1.0 (без изменений)
AutoBalance.RewardScaling.Money = 1
AutoBalance.RewardScaling.Money.Modifier = 1.0

##########################
#
# Уведомления
#
##########################

#
#     AutoBalance.PlayerChangeNotify
#        Настроить автоматические уведомления для всех игроков в инстансе об изменении количества игроков.
#        По умолчанию:     1 (1 = ВКЛ, 0 = ВЫКЛ)
AutoBalance.PlayerChangeNotify = 1

##########################
#
# СИСТЕМА ВОЗНАГРАЖДЕНИЯ (экспериментальная)
#
##########################

#
#   AutoBalance.reward.enable
#       Это экспериментальная функция, предназначенная для награждения игрока, убившего босса в подземелье
#       или рейде эпохи до WotLK при включенной системе повышения уровня существ.
#       Эта идея поможет вдохнуть новую жизнь в старый контент, даже если вы уже достигли финального этапа игры.
#
#       По умолчанию:     0 (1 = ВКЛ, 0 = ВЫКЛ)
AutoBalance.reward.enable = 0


#
#   AutoBalance.reward.raidToken
#   AutoBalance.reward.dungeonToken
#
#
#       По умолчанию
#           raidToken -> emblem of frost (49426)
#           dungeonToken -> emblem of triumph (47241)
AutoBalance.reward.raidToken    = 49426
AutoBalance.reward.dungeonToken = 47241

#
#   AutoBalance.reward.MinPlayerReward
#       Эта настройка проверяет количество игроков на карте перед выдачей награды.
#       Например, если параметр `MinPlayerReward` установлен на 2, а игрок проходит подземелье в одиночку,
#       награда не будет выдана. Это усложняет прохождение низкоуровневых инстансов.
#
#       По умолчанию:     1
AutoBalance.reward.MinPlayerReward = 1

##########################
#
# Объявления
#
##########################

#
#     AutoBalanceAnnounce.enable
#        Объявлять о модуле при входе в систему, если он включен.
#        По умолчанию:     1 (1 = ВКЛ, 0 = ВЫКЛ)
AutoBalanceAnnounce.enable=1

##########################
#
# Устаревшие настройки
#
##########################

# Следующие переменные устарели, и их не следует использовать при новых развертываниях. Для них не нужно указывать значения.
# Они по-прежнему будут применяться для обеспечения обратной совместимости, но будут полностью удалены в одном из будущих выпусков.
# Весь их функционал (и даже больше) перенесен в новые настройки, на которые ссылается этот файл конфигурации.
#
AutoBalance.enable=
AutoBalance.PerDungeonScaling=
AutoBalance.PerDungeonBossScaling=
AutoBalance.BossInflectionMult=
AutoBalance.rate.global=
AutoBalance.rate.health=
AutoBalance.rate.mana=
AutoBalance.rate.armor=
AutoBalance.rate.damage=
AutoBalance.DungeonScaleDownXP=
AutoBalance.DungeonScaleDownMoney=
AutoBalance.LevelHigherOffset=
AutoBalance.LevelLowerOffset=
AutoBalance.PerDungeonPlayerCounts=

# Следующие переменные были полностью удалены; их не следует использовать при новом или существующем развертывании.
# Для них следует оставить пустые значения.
# Весь их функционал (и даже больше) перенесен в новые настройки, на которые ссылается этот файл конфигурации.
AutoBalance.DungeonsOnly=
AutoBalance.levelUseDbValuesWhenExists=
