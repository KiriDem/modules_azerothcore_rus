[worldserver]
##########################
#
# Журналирование
#
# Добавьте эти строки в файл worldserver.conf, чтобы включить журналирование для AutoBalance.
# Обязательно добавьте их после строки `Logger.module=4,Console Server`.
#
# 4 = Info (По умолчанию), 5 = Debug
#
##########################
# Logger.module.AutoBalance=4,Console Server
# Logger.module.AutoBalance_CombatLocking=4,Console Server
# Logger.module.AutoBalance_DamageHealingCC=4,Console Server
# Logger.module.AutoBalance_StatGeneration=4,Console Server

##########################
#
# Enable / Disable Settings
#
##########################

#
#     AutoBalance.Enable
#        Включите/отключите все функции глобально. Если этот параметр выключен, все последующие настройки не вступят в силу.
#        По умолчанию:     1 (1 = ВКЛ, 0 = ВЫКЛ)
AutoBalance.Enable.Global=1

#
#     AutoBalance.Enabled.*
#        Включить или отключить все функции для каждого размера подземелья и уровня сложности.
#        Если здесь для размера подземелья установлено значение 0, то никакие другие настройки для этого размера подземелья не вступят в силу.
#        По умолчанию:     1 (1 = ВКЛ, 0 = ВЫКЛ)
#
AutoBalance.Enable.5M=1
AutoBalance.Enable.10M=1
AutoBalance.Enable.15M=1
AutoBalance.Enable.20M=1
AutoBalance.Enable.25M=1
AutoBalance.Enable.40M=1
AutoBalance.Enable.OtherNormal=1

AutoBalance.Enable.5MHeroic=1
AutoBalance.Enable.10MHeroic=1
AutoBalance.Enable.25MHeroic=1
AutoBalance.Enable.OtherHeroic=1

#
#     AutoBalance.Disable.PerInstance
#        Отключите все функции для указанных ID подземелий. Если идентификатор экземпляра здесь не указан,
#        для этого подземелья будут применяться настройки `AutoBalance.Enable.*`.
#
#        Получите список ID подземелий здесь: https://wowpedia.fandom.com/wiki/InstanceID#Classic
#
#        Формат: "[InstanceID], [InstanceID], [InstanceID], ..."
#
#        Пример: AutoBalance.Disable.PerInstance="33, 43, 129"
#
#        По умолчанию: ""
AutoBalance.Disable.PerInstance = ""

##########################
#
# Минимальное количество игроков
#
##########################
#
#     AutoBalance.MinPlayers
#     AutoBalance.MinPlayers.Heroic
#        Устанавливает минимальное количество игроков, до которого масштабируются все подземелья обычного и героического режимов.
#        Если в инстанс входит меньше указанного количества игроков, масштабируется до указанного значения.
#
#        ПРИМЕЧАНИЕ: Поправка сложности для игрока применяется ПОСЛЕ того, как количество игроков корректируется с учетом параметра MinPlayer.
#
#        AutoBalance.MinPlayers затрагивает только обычные подземелья.
#        AutoBalance.MinPlayers.Heroic влияет только на героические подземелья.
#
#        Пример: AutoBalance.MinPlayers = 1
#                AutoBalance.MinPlayers.Heroic = 5
#
#        По умолчанию: 1
AutoBalance.MinPlayers = 1
AutoBalance.MinPlayers.Heroic = 1
AutoBalance.MinPlayers.Raid = 1
AutoBalance.MinPlayers.RaidHeroic = 1

#
#     AutoBalance.MinPlayers.PerInstance
#     AutoBalance.MinPlayers.Heroic.PerInstance
#        Задает минимальное количество игроков, до которого может быть уменьшен размер группы для конкретного подземелья (instance ID).
#        Если в подземелье входит меньше указанного количества игроков, масштабируется до указанного значения.
#
#        ПРИМЕЧАНИЕ: Поправка сложности для игрока применяется ПОСЛЕ того, как количество игроков корректируется с учетом настройки MinPlayer.
#
#        AutoBalance.MinPlayers.PerInstance затрагивает только обычные подземелья.
#        AutoBalance.MinPlayers.Heroic.PerInstance влияет только на героические подземелья.
#
#        Если ID подземелья не указан в этом списке, минимальное количество игроков устанавливается с помощью стандартных настроек MinPlayers.
#
#        Получите список ID подземелий здесь: https://wowpedia.fandom.com/wiki/InstanceID#Classic
#
#        Формат: "[InstanceID] [MinPlayers], [InstanceID] [MinPlayers], [InstanceID] [MinPlayers], ..."
#
#        Пример: AutoBalance.MinPlayers.PerInstance="33 2, 43 5, 129 4"
#                 AutoBalance.MinPlayers.PerInstance="33 5, 43 5, 129 5"
#
#        По умолчанию: ""
AutoBalance.MinPlayers.PerInstance = ""
AutoBalance.MinPlayers.Heroic.PerInstance = ""

##########################
#
# Масштабирование характеристик — точка перегиба
#
##########################

#     AutoBalance.InflectionPoint* series
#        InflectionPoint
#           Изменяет точку перегиба функции гиперболического тангенса, определяющей множитель характеристик врагов в зависимости от количества игроков.
#           Этот параметр регулирует форму общей кривой. Более низкое значение означает, что сложность будет возрастать быстрее по мере добавления игроков.
#
#           На этом изображении наглядно показаны различные настройки параметра «Точка перегиба» (Inflection Point) и их влияние на множители характеристик противников.
#           https://i.imgur.com/x42UnUR.png
#
#           Пример: Если параметр InflectionPointRaid равен 0,5, то в подземелье на 40 игроков у противника останется половина запаса здоровья, когда в подземелье будет находиться 20 игроков.
#                   Если параметр InflectionPointRaid равен 0,8, то у противника в рейде на 40 игроков останется половина запаса здоровья, когда в подземелье будет находиться 12 игроков.
#
#           По умолчанию: 0.5
#
#        CurveFloor
#           При расчете кривой для определения множителя противника начинайте кривую с этого значения.
#
#           Это позволяет повысить характеристики врагов при малом количестве игроков, не затрагивая при этом
#           характеристики для большего числа игроков. Применяется до учета значений `AutoBalance.StatModifier*`.
#
#           Значение может быть отрицательным, если это необходимо для получения желаемой кривой.
#
#           Чтобы понять, как CurveFloor и CurveCeiling влияют на множитель, посмотрите на это изображение:
#           https://i.imgur.com/I8S4cwJ.png
#
#           По умолчанию: 0.0
#
#        CurveCeiling
#           После расчета кривой для определения множителя противника, завершите построение кривой на этом значении.
#
#           Это позволяет снизить характеристики врагов при большом количестве игроков, не затрагивая при этом 
#           характеристики для малого числа игроков. Применяется до учета значений `AutoBalance.StatModifier*`.
#
#           Чтобы понять, как CurveFloor и CurveCeiling влияют на множитель, посмотрите на это изображение:
#           https://i.imgur.com/I8S4cwJ.png
#
#           Можно установить значение выше 1,0, чтобы повысить сложность инстанса по сравнению со стандартными показателями:
#           https://i.imgur.com/DBPxT8E.png
#
#           По умолчанию: 1.0
#
#       BossModifier
#           Значение InflectionPoint умножается на это значение для существ, считающихся боссами подземелий (из подземелий или рейдов).
#           Это множитель, а не новая «точка перегиба» (Inflection Point). Значения выше 1,0 делают врагов проще при малом количестве
#           игроков, а значения ниже 1,0 — также делают их проще при малом количестве игроков.
#
#           Чтобы лучше понять этот эффект, ознакомьтесь с интерактивной электронной таблицей, описание которой приведено ниже.
#
#           По умолчанию: 1.0
#
#
#     Доступна интерактивная электронная таблица, позволяющая наглядно увидеть, как выбранные вами настройки влияют на кривую сложности.
#
#     https://docs.google.com/spreadsheets/d/100cmKIJIjCZ-ncWd0K9ykO8KUgwFTcwg4h2nfE_UeCc/copy
#
#     Чтобы воспользоваться таблицей, скопируйте её на свой Google Диск и измените значения в левой части, выделенные жёлтым цветом.
#     Значение "Final Multiplier" — это фактический множитель, который будет применен к врагам в конкретном подземелье.

### Подземелья для 5 игроков
AutoBalance.InflectionPoint=0.5
AutoBalance.InflectionPoint.CurveFloor=0.0
AutoBalance.InflectionPoint.CurveCeiling=1.0
AutoBalance.InflectionPoint.BossModifier=1.0

### Героические подземелья для 5 игроков
AutoBalance.InflectionPointHeroic=0.5
AutoBalance.InflectionPointHeroic.CurveFloor=0.0
AutoBalance.InflectionPointHeroic.CurveCeiling=1.0
AutoBalance.InflectionPointHeroic.BossModifier=1.0

### По умолчанию: для всех рейдов
AutoBalance.InflectionPointRaid=0.5
AutoBalance.InflectionPointRaid.CurveFloor=0.0
AutoBalance.InflectionPointRaid.CurveCeiling=1.0
AutoBalance.InflectionPointRaid.BossModifier=1.0

### По умолчанию: для всех героических рейдов
AutoBalance.InflectionPointRaidHeroic=0.5
AutoBalance.InflectionPointRaidHeroic.CurveFloor=0.0
AutoBalance.InflectionPointRaidHeroic.CurveCeiling=1.0
AutoBalance.InflectionPointRaidHeroic.BossModifier=1.0

###
### По умолчанию: все подземелья используют настройки, заданные выше.
### Чтобы изменить настройки для конкретного размера подземелья или уровня сложности, укажите значения соответствующих переменных ниже.
### Если переменная не задана, будут применяться общие настройки, указанные выше.
###

### Подземелья для 10 игроков
AutoBalance.InflectionPointRaid10M=
AutoBalance.InflectionPointRaid10M.CurveFloor=
AutoBalance.InflectionPointRaid10M.CurveCeiling=
AutoBalance.InflectionPointRaid10M.BossModifier=

### Героические подземелья для 10 игроков
AutoBalance.InflectionPointRaid10MHeroic=
AutoBalance.InflectionPointRaid10MHeroic.CurveFloor=
AutoBalance.InflectionPointRaid10MHeroic.CurveCeiling=
AutoBalance.InflectionPointRaid10MHeroic.BossModifier=

### Рейды на 15 игроков
AutoBalance.InflectionPointRaid15M=
AutoBalance.InflectionPointRaid15M.CurveFloor=
AutoBalance.InflectionPointRaid15M.CurveCeiling=
AutoBalance.InflectionPointRaid15M.BossModifier=

### Рейды на 20 игроков
AutoBalance.InflectionPointRaid20M=
AutoBalance.InflectionPointRaid20M.CurveFloor=
AutoBalance.InflectionPointRaid20M.CurveCeiling=
AutoBalance.InflectionPointRaid20M.BossModifier=

### Рейды на 25 игроков
AutoBalance.InflectionPointRaid25M=
AutoBalance.InflectionPointRaid25M.CurveFloor=
AutoBalance.InflectionPointRaid25M.CurveCeiling=
AutoBalance.InflectionPointRaid25M.BossModifier=

### Героические рейды на 25 игроков
AutoBalance.InflectionPointRaid25MHeroic=
AutoBalance.InflectionPointRaid25MHeroic.CurveFloor=
AutoBalance.InflectionPointRaid25MHeroic.CurveCeiling=
AutoBalance.InflectionPointRaid25MHeroic.BossModifier=

### Рейды на 40 игроков
AutoBalance.InflectionPointRaid40M=
AutoBalance.InflectionPointRaid40M.CurveFloor=
AutoBalance.InflectionPointRaid40M.CurveCeiling=
AutoBalance.InflectionPointRaid40M.BossModifier=

#
#     AutoBalance.InflectionPoint.PerInstance
#        Задает настройки точки перегиба для конкретных `InstanceID`.
#
#        Получите список ID подземелий здесь: https://wowpedia.fandom.com/wiki/InstanceID#Classic
#
#        Указание значения `-1` означает, что переопределение данного параметра выполняться не будет. Для экземпляров, не указанных в списке,
#        будут использоваться значения по умолчанию, соответствующие их сложности и размеру. 
#        При необходимости записи в конце строки можно опустить.
#
#        Формат: "[InstanceID] [InflectionPoint] [CurveFloor] [CurveCeiling], [InstanceID] [InflectionPoint] [CurveFloor] [CurveCeiling], ..."
#
#        Пример: AutoBalance.InflectionPoint.PerInstance="229 0.4 0.0 1.5, 309 -1 0.0 1.1, 48 0.3"
#
#        По умолчанию: ""
#
AutoBalance.InflectionPoint.PerInstance=""

#
#     AutoBalance.InflectionPoint.Boss.PerInstance
#        Задает параметры «точки перегиба» (Inflection Point) для всех боссов в указанных `InstanceID`. Обратите внимание: первое значение — это `InflectionPointMultiplier`,
#        который работает так же, как параметр `BossModifier`. «Нормальная» точка перегиба для боссов умножается на это значение.
#        Чтобы лучше понять этот эффект, ознакомьтесь с интерактивной таблицей.
#
#        Получите список ID подземелий здесь: https://wowpedia.fandom.com/wiki/InstanceID#Classic
#
#        Для экземпляров, не указанных в списке, будут использоваться значения перегиба (inflection value), принятые По умолчанию: для
#        соответствующих уровня сложности и размера. Для каждого InstanceID следует указывать только один набор значений.
#
#        Формат: "[InstanceID] [InflectionPointMultiplier], [InstanceID] [InflectionPointMultiplier], ..."
#
#        Пример: AutoBalance.InflectionPoint.Boss.PerInstance="229 1.2, 309 1.5, 48 1.25"
#
#        По умолчанию: ""
#
AutoBalance.InflectionPoint.Boss.PerInstance=""

#
#     AutoBalance.playerCountDifficultyOffset
#        Смещение игроков внутри инстанса. Влияет на все типы инстансов.
#        По умолчанию:     0
AutoBalance.playerCountDifficultyOffset=0

##########################
#
# Масштабирование характеристик — Модификаторы характеристик
#
##########################

#     AutoBalance.StatModifier* series
#        Кривая сложности (определяемая настройками InflectionPoint) задает базовый множитель. Затем этот базовый множитель
#        корректируется (умножается) с учетом соответствующей настройки StatModifier. Это позволяет регулировать
#        баланс влияния масштабирования на четыре настраиваемых параметра: здоровье, ману, броню и урон.
#
#        AutoBalance.StatModifier*.<Stat> -- действует только на существ, не являющихся боссами
#        AutoBalance.StatModifier*.Boss.<Stat> -- действует только на боссов
#
#        Чтобы увидеть это в действии, измените значение `StatModifier` в электронной таблице:
#        https://docs.google.com/spreadsheets/d/100cmKIJIjCZ-ncWd0K9ykO8KUgwFTcwg4h2nfE_UeCc/copy
#
#        Чтобы воспользоваться таблицей, скопируйте её на свой Google Диск и измените значения в левой части, выделенные жёлтым цветом.
#        Значение "Final Multiplier" — это фактический множитель, который будет применен к противникам в конкретном экземпляре (инстансе).
#
#        Global
#           Умножьте остальные четыре параметра на это значение. Это позволяет увеличить все характеристики (здоровье, ману, броню,
#           урон) одним действием. При этом используются как глобальный множитель, так и множитель для конкретной характеристики.
#
#           Пример: Если параметр "Global" равен 0,5, а "Health" — 1,5, то здоровье существа будет умножено на 0,75 от
#                   его исходного значения (после поправки на количество игроков).
#
#           По умолчанию: 1.0
#
#        Health | Mana | Armor | Damage
#           Корректирует модификатор характеристики для соответствующей характеристики. Зависит от глобального модификатора характеристики, указанного выше.
#
#           ПРИМЕЧАНИЕ: "Damage" влияет как на урон по существам, так и на урон по окружающему миру.
#
#           По умолчанию: 1.0
#
#        Boss.Global | Boss.Health | Boss.Mana | Boss.Armor | Boss.Damage
#           Устанавливает отдельный множитель характеристик для боссов. На него НЕ влияют модификаторы, предназначенные для обычных
#           существ. Применяется только к существам, считающимся боссами инстансов (в подземельях или рейдах).
#
#           По умолчанию: Если для конкретного размера или типа подземелья/рейда не заданы иные параметры, используются значения по умолчанию.
#
#           Чтобы лучше понять этот эффект, ознакомьтесь с интерактивной электронной таблицей.
#

### Подземелья для 5 игроков
AutoBalance.StatModifier.Global=1.0
AutoBalance.StatModifier.Health=1.0
AutoBalance.StatModifier.Mana=1.0
AutoBalance.StatModifier.Armor=1.0
AutoBalance.StatModifier.Damage=1.0

AutoBalance.StatModifier.Boss.Global=1.0
AutoBalance.StatModifier.Boss.Health=1.0
AutoBalance.StatModifier.Boss.Mana=1.0
AutoBalance.StatModifier.Boss.Armor=1.0
AutoBalance.StatModifier.Boss.Damage=1.0

### Героические подземелья для 5 игроков
AutoBalance.StatModifierHeroic.Global=1.0
AutoBalance.StatModifierHeroic.Health=1.0
AutoBalance.StatModifierHeroic.Mana=1.0
AutoBalance.StatModifierHeroic.Armor=1.0
AutoBalance.StatModifierHeroic.Damage=1.0

AutoBalance.StatModifierHeroic.Boss.Global=1.0
AutoBalance.StatModifierHeroic.Boss.Health=1.0
AutoBalance.StatModifierHeroic.Boss.Mana=1.0
AutoBalance.StatModifierHeroic.Boss.Armor=1.0
AutoBalance.StatModifierHeroic.Boss.Damage=1.0

### По умолчанию: для всех рейдов
AutoBalance.StatModifierRaid.Global=1.0
AutoBalance.StatModifierRaid.Health=1.0
AutoBalance.StatModifierRaid.Mana=1.0
AutoBalance.StatModifierRaid.Armor=1.0
AutoBalance.StatModifierRaid.Damage=1.0

AutoBalance.StatModifierRaid.Boss.Global=1.0
AutoBalance.StatModifierRaid.Boss.Health=1.0
AutoBalance.StatModifierRaid.Boss.Mana=1.0
AutoBalance.StatModifierRaid.Boss.Armor=1.0
AutoBalance.StatModifierRaid.Boss.Damage=1.0

### По умолчанию: для всех героических рейдов
AutoBalance.StatModifierRaidHeroic.Global=1.0
AutoBalance.StatModifierRaidHeroic.Health=1.0
AutoBalance.StatModifierRaidHeroic.Mana=1.0
AutoBalance.StatModifierRaidHeroic.Armor=1.0
AutoBalance.StatModifierRaidHeroic.Damage=1.0

AutoBalance.StatModifierRaidHeroic.Boss.Global=1.0
AutoBalance.StatModifierRaidHeroic.Boss.Health=1.0
AutoBalance.StatModifierRaidHeroic.Boss.Mana=1.0
AutoBalance.StatModifierRaidHeroic.Boss.Armor=1.0
AutoBalance.StatModifierRaidHeroic.Boss.Damage=1.0

###
### По умолчанию: все подземелья используют настройки, заданные выше. Чтобы изменить настройки для конкретного размера
### подземелья или уровня сложности, укажите значения соответствующих переменных ниже. Если переменная не задана,
### будут применяться общие настройки, указанные выше.
###

### Подземелья для 10 игроков
AutoBalance.StatModifierRaid10M.Global=
AutoBalance.StatModifierRaid10M.Health=
AutoBalance.StatModifierRaid10M.Mana=
AutoBalance.StatModifierRaid10M.Armor=
AutoBalance.StatModifierRaid10M.Damage=

AutoBalance.StatModifierRaid10M.Boss.Global=
AutoBalance.StatModifierRaid10M.Boss.Health=
AutoBalance.StatModifierRaid10M.Boss.Mana=
AutoBalance.StatModifierRaid10M.Boss.Armor=
AutoBalance.StatModifierRaid10M.Boss.Damage=

### Героические подземелья для 10 игроков
AutoBalance.StatModifierRaid10MHeroic.Global=
AutoBalance.StatModifierRaid10MHeroic.Health=
AutoBalance.StatModifierRaid10MHeroic.Mana=
AutoBalance.StatModifierRaid10MHeroic.Armor=
AutoBalance.StatModifierRaid10MHeroic.Damage=

AutoBalance.StatModifierRaid10MHeroic.Boss.Global=
