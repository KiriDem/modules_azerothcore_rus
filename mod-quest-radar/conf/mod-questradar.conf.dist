[worldserver]

###############################################################################
#   mod-questradar.conf
#   Модуль AzerothCore — местоположение целей заданий (на стороне сервера)
###############################################################################

#
#    QuestRadar.Enable
#        Описание: Включить/Выключить модуль
#
#        По умолчанию: 1 - Включенно
#                      0 - Выключенно
#

QuestRadar.Enable = 1

#
#    QuestRadar.AnnounceOnAccept
#        Описание: Автоматически сообщает в чат (сразу после принятия задания) об известных целях,
#                  ближайших к текущей карте игрока (на основе таблиц `quest_poi` / `quest_poi_points`).
#
#        По умолчанию: 1 - Включенно
#                      0 - Выключенно (игрок по-прежнему может использовать .questradar)
#

QuestRadar.AnnounceOnAccept = 1

#
#    QuestRadar.MaxObjectivesShown
#        Описание: Максимальное количество целей, отображаемых для каждого оповещения или при использовании команды .questradar / .qr.
#
#        По умолчанию: 3
#

QuestRadar.MaxObjectivesShown = 3

#
#    QuestRadar.AddonSyncВключенно
#        Описание: Активирует канал обмена данными между сервером и аддоном (CHAT_MSG_ADDON / LANG_ADDON),
#                  который используется клиентским аддоном QuestRadar (client-addon/QuestRadar/) для
#                  отображения целей на мини-карте и карте мира. Если аддон не установлен на стороне клиента,
#                  эта настройка не дает видимого эффекта (клиент просто игнорирует необработанные сообщения).
#
#        По умолчанию: 1 - Включенно
#                      0 - Выключенно (функции чата остаются доступными независимо от этой настройки)
#

QuestRadar.AddonSyncВключенно = 1
