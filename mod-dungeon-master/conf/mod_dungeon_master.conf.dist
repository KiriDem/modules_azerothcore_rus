########################################
# НАСТРОЙКИ МОДУЛЯ DUNGEON MASTER
########################################
#
# Система процедурно генерируемых подземелий-испытаний для AzerothCore.
# Игроки взаимодействуют с NPC-распорядителем, выбирают сложность, тематику и само подземелье,
# после чего перемещаются в инстанс, заполненный тематическими монстрами, соответствующими уровню персонажей.
# Зачистите подземелье и победите босса, чтобы получить награду.
#

###############################################################################
# ОСНОВНЫЕ НАСТРОЙКИ
###############################################################################

#    DungeonMaster.Enable
#        По умолчанию: 1
DungeonMaster.Enable = 1

#    DungeonMaster.Debug
#        По умолчанию: 0
DungeonMaster.Debug = 0

#    DungeonMaster.NpcEntry
#        creature_template номер для DM NPC
#        По умолчанию: 500000
DungeonMaster.NpcEntry = 500000

###############################################################################
# УРОВНИ СЛОЖНОСТИ
# Формат: "Name,MinLevel,MaxLevel,HealthMult,DamageMult,RewardMult,MobMult"
###############################################################################

DungeonMaster.Difficulty.1 = "Новичок,10,19,0.6,0.6,1.0,0.5"
DungeonMaster.Difficulty.2 = "Ученик,20,29,0.8,0.8,1.5,0.7"
DungeonMaster.Difficulty.3 = "Подмастерье,30,44,1.0,1.0,2.0,0.85"
DungeonMaster.Difficulty.4 = "Эксперт,45,59,1.3,1.2,3.0,1.0"
DungeonMaster.Difficulty.5 = "Мастер,60,69,1.6,1.4,4.0,1.0"
DungeonMaster.Difficulty.6 = "Грандмасте,70,80,2.0,1.6,6.0,1.2"
DungeonMaster.Difficulty.7 = ""
DungeonMaster.Difficulty.8 = ""
DungeonMaster.Difficulty.9 = ""
DungeonMaster.Difficulty.10 = ""

###############################################################################
# МАСШТАБИРОВАНИЕ
#
# ДИАПАЗОН УРОВНЕЙ (НОВОВВЕДЕНИЕ — исправляет появление существ разных уровней)
#   Существа выбираются в пределах диапазона «Эффективный уровень ± Диапазон уровней».
#   EffectiveLevel = уровень игрока-одиночки или средний уровень группы.
#   Значение также ограничивается минимальным и максимальным пределами уровня сложности.
#
#   Пример: Игрок 35-го уровня, диапазон уровней 3, подмастерье (30–44)
#            → существа должны быть 32–38-го уровня.
#
#   Увеличьте до 5 для большего разнообразия. Уменьшите до 1–2 для строгого соответствия.
###############################################################################

#    DungeonMaster.Scaling.LevelBand
#        Окно выбора существа: effective_level ± это значение
#        По умолчанию: 3
DungeonMaster.Scaling.LevelBand = 3

#    DungeonMaster.Scaling.PerPlayerHealth
#        Множитель здоровья, добавляемый за каждого участника группы, начиная со второго.
#        По умолчанию: 0.25  (Каждый дополнительный игрок добавляет 25% здоровья.)
DungeonMaster.Scaling.PerPlayerHealth = 0.25

#    DungeonMaster.Scaling.PerPlayerDamage
#        Множитель урона добавляется за каждого дополнительного участника группы.
#        По умолчанию: 0.1
DungeonMaster.Scaling.PerPlayerDamage = 0.1

#    DungeonMaster.Scaling.SoloMultiplier
#        Общее снижение сложности для игроков-одиночек
#        По умолчанию: 0.5  (Характеристики существ составляют 50% от стандартных значений.)
DungeonMaster.Scaling.SoloMultiplier = 0.5

#    DungeonMaster.Scaling.EliteHealthMult
#        Множитель здоровья для элитных рядовых противников (сверх бонусов от уровня сложности)
#        По умолчанию: 2.0
DungeonMaster.Scaling.EliteHealthMult = 2.0

#    DungeonMaster.Scaling.EliteDamageMult
#        Множитель урона по элитным рядовым противникам
#        По умолчанию: 1.5
DungeonMaster.Scaling.EliteDamageMult = 1.5

#    DungeonMaster.Scaling.BossHealthMult
#        Множитель здоровья боссов (сверх масштабирования под размер группы)
#        По умолчанию: 8.0
DungeonMaster.Scaling.BossHealthMult = 8.0

#    DungeonMaster.Scaling.BossDamageMult
#        Множитель урона для боссов (применяется только поверх масштабирования в зависимости
#        от размера группы, НЕ суммируется с множителем урона, зависящим от уровня сложности)
#        По умолчанию: 1.5
DungeonMaster.Scaling.BossDamageMult = 1.5

###############################################################################
# ВИЗУАЛЬНЫЙ МАСШТАБ И РАЗНООБРАЗИЕ
# Сохраняется полный набор существ. Меняется только визуальный размер
# недавние варианты не используются, если есть альтернативы.
DungeonMaster.VisualScale.Beast = 1.00
DungeonMaster.VisualScale.Dragonkin = 0.85
DungeonMaster.VisualScale.Demon = 0.95
DungeonMaster.VisualScale.Elemental = 0.90
DungeonMaster.VisualScale.Giant = 0.70
DungeonMaster.VisualScale.Undead = 1.00
DungeonMaster.VisualScale.Humanoid = 1.00
DungeonMaster.VisualScale.Mechanical = 0.90
DungeonMaster.Variety.RecentEntries = 12

# НАГРАДЫ
###############################################################################

#    DungeonMaster.Rewards.BaseGold    (медь)       По умолчанию: 50000 (5з)
DungeonMaster.Rewards.BaseGold = 50000

#    DungeonMaster.Rewards.GoldPerMob  (медь)       По умолчанию: 50
DungeonMaster.Rewards.GoldPerMob = 50

#    DungeonMaster.Rewards.GoldPerBoss (медь)       По умолчанию: 10000 (1з)
DungeonMaster.Rewards.GoldPerBoss = 10000

#    DungeonMaster.Rewards.XPMultiplier             По умолчанию: 1.0
DungeonMaster.Rewards.XPMultiplier = 1.0

#    DungeonMaster.Rewards.ItemChance  (0-100)      По умолчанию: 80
DungeonMaster.Rewards.ItemChance = 80

#    DungeonMaster.Rewards.RareChance  (0-100)      По умолчанию: 40
DungeonMaster.Rewards.RareChance = 40

#    DungeonMaster.Rewards.EpicChance  (0-100)      По умолчанию: 15
DungeonMaster.Rewards.EpicChance = 15

###############################################################################
# НАСТРОЙКИ ПОДЗЕМЕЛЬЯ
###############################################################################

#    DungeonMaster.Dungeon.BossCount
#        Количество боссов (размещенных в самых дальних точках появления)
#        По умолчанию: 1
DungeonMaster.Dungeon.BossCount = 1

#    DungeonMaster.Dungeon.EliteChance  (0-100)
#        Шанс того, что рядовой противник окажется элитным (получает множитель здоровья элитных врагов — EliteHealthMult)
#        По умолчанию: 20
DungeonMaster.Dungeon.EliteChance = 20

#    DungeonMaster.Dungeon.AggroRadius
#        Радиус обнаружения для появившихся существ (в ярдах).
#        Определяет расстояние, на котором моб замечает игроков и проявляет к ним агрессию.
#        По умолчанию: 15.0  (снижено по сравнению со стандартным для WoW диапазоном ~20–45)
#        Более низкие значения (8–12) делают подземелья менее «кишащими» врагами.
#        Существа патрулируют территорию в радиусе 5 ярдов вокруг точек своего появления.
DungeonMaster.Dungeon.AggroRadius = 15.0

#    DungeonMaster.Dungeon.RareSpawnChance  (0-100)
#        Шанс появления редкого врага за один заход в подземелье (проверяется один раз).
#        Редкие монстры отличаются портретом с серебряным драконом и улучшенной добычей.
#        По умолчанию: 5
DungeonMaster.Dungeon.RareSpawnChance = 5

#    DungeonMaster.Scaling.RareHealthMult
#        Множитель здоровья для редких противников (промежуточное звено между элитными врагами и боссами).
#        По умолчанию: 4.0
DungeonMaster.Scaling.RareHealthMult = 4.0

#    DungeonMaster.Scaling.RareDamageMult
#        Множитель урона для редких противников.
#        По умолчанию: 2.0
DungeonMaster.Scaling.RareDamageMult = 2.0

#    DungeonMaster.Dungeon.Whitelist
#        ID карт, разделенные запятыми (пустое поле — разрешены все)
DungeonMaster.Dungeon.Whitelist = ""

#    DungeonMaster.Dungeon.Blacklist
#        ID карт, разделенные запятыми, которые следует исключить
DungeonMaster.Dungeon.Blacklist = ""

###############################################################################
# ТЕМЫ
# Формат: "DisplayName,CreatureType[,CreatureType...]"
# Типы: 1=Зверь 2=Драконид 3=Демон 4=Элементаль 5=​​Великан
#       6=Нежить 7=Гуманоид 9=Механизм   -1=Любой (случайный)
###############################################################################

DungeonMaster.Theme.1 = "Охота на Зверя,1"
DungeonMaster.Theme.2 = "Логово Дракона,2"
DungeonMaster.Theme.3 = "Вторжение Демонов,3"
DungeonMaster.Theme.4 = "Стихийный Хаос,4"
DungeonMaster.Theme.5 = "Твердыня Великана,5"
DungeonMaster.Theme.6 = "Восстание Нежити,6"
DungeonMaster.Theme.7 = "Оплот Гуманоидов,7"
DungeonMaster.Theme.8 = "Механический Хаос,9"
DungeonMaster.Theme.9 = "Случайный Хаос,-1"
DungeonMaster.Theme.10 = ""
DungeonMaster.Theme.11 = ""
DungeonMaster.Theme.12 = ""
DungeonMaster.Theme.13 = ""
DungeonMaster.Theme.14 = ""
DungeonMaster.Theme.15 = ""
DungeonMaster.Theme.16 = ""
DungeonMaster.Theme.17 = ""
DungeonMaster.Theme.18 = ""
DungeonMaster.Theme.19 = ""
DungeonMaster.Theme.20 = ""

###############################################################################
# TIMERS
###############################################################################

#    DungeonMaster.Cooldown.Minutes (0 = без времени восстановления)
#        По умолчанию: 5
DungeonMaster.Cooldown.Minutes = 5

#    DungeonMaster.TimeLimit.Enable       По умолчанию: 0
DungeonMaster.TimeLimit.Enable = 0

#    DungeonMaster.TimeLimit.Minutes      По умолчанию: 30
DungeonMaster.TimeLimit.Minutes = 30

#    DungeonMaster.MaxConcurrentRuns      По умолчанию: 20
DungeonMaster.MaxConcurrentRuns = 20

###############################################################################
# ОБРАБОТКА СМЕРТИ
###############################################################################

#    DungeonMaster.Death.RespawnAtStart
#        Автоматическое воскрешение погибших игроков у входа при выходе группы из боя.
#        По умолчанию: 1
DungeonMaster.Death.RespawnAtStart = 1

#    DungeonMaster.Death.MaxWipes
#        Полное уничтожение группы перед автоматическим провалом (0 = неограниченное количество)
#        По умолчанию: 0
DungeonMaster.Death.MaxWipes = 0

###############################################################################
# ЗАВЕРШЕНИЕ
###############################################################################

#    DungeonMaster.Completion.TeleportDelay
#        Через сколько секунд после смерти босса наступит телепортация наружу
#        По умолчанию: 30
DungeonMaster.Completion.TeleportDelay = 30

#    DungeonMaster.Completion.Announcement
#        Объявить игроку о начале испытания.
#        По умолчанию: 1
DungeonMaster.Completion.Announcement = 1

###############################################################################
# РЕЖИМ «РОГАЛИКА»
#
# Бесконечное прохождение подземелий. Отряд зачищает подземелья, пока не погибнет.
# Каждое успешное прохождение повышает уровень сложности: враги становятся сильнее, а отряд получает усиления.
###############################################################################

#    DungeonMaster.Roguelike.Enable
#        Главный переключатель режима «Рогалик».
#        По умолчанию: 1
DungeonMaster.Roguelike.Enable = 1

#    DungeonMaster.Roguelike.TransitionDelay
#        Секунды между зачистками подземелья (фаза сбора добычи / обратный отсчет).
#        По умолчанию: 30
DungeonMaster.Roguelike.TransitionDelay = 30

# --- МАСШТАБИРОВАНИЕ СЛОЖНОСТИ ---
# Множители для каждого уровня. Масштабирование — линейное вплоть до порога
# экспоненциального роста (ExponentialThreshold), а после его превышения — экспоненциальное.
#
# Формула (уровень <= порог): 1,0 + (уровень - 1) * ScalingPerTier
# Формула (уровень > порог): линейная часть + сумма ScalingPerTier * ExpFactor^(t-порог+1)

#    DungeonMaster.Roguelike.HpScalingPerTier
#        Увеличение множителя здоровья за уровень.
#        По умолчанию: 0.10  (+10% за уровень в линейной зоне)
DungeonMaster.Roguelike.HpScalingPerTier = 0.10

#    DungeonMaster.Roguelike.DmgScalingPerTier
#        Увеличение множителя урона за уровень.
#        По умолчанию: 0.08  (+8% за уровень)
DungeonMaster.Roguelike.DmgScalingPerTier = 0.08

#    DungeonMaster.Roguelike.ArmorScalingPerTier
#        Увеличение множителя брони за уровень (только линейное).
#        По умолчанию: 0.05  (+5% за уровень)
DungeonMaster.Roguelike.ArmorScalingPerTier = 0.05

#    DungeonMaster.Roguelike.ExponentialThreshold
#        Уровень, на котором масштабирование переключается с линейного на экспоненциальное.
#        По умолчанию: 5
DungeonMaster.Roguelike.ExponentialThreshold = 5

#    DungeonMaster.Roguelike.ExponentialFactor
#        Основание экспоненциального роста за пределами порогового значения.
#        По умолчанию: 1.15
DungeonMaster.Roguelike.ExponentialFactor = 1.15

# --- АФФИКСЫ (модификаторы в стиле Mythic+) ---
# Аффиксы — это модификаторы характеристик, применяемые ко всем этажам подземелья на высоких уровнях сложности.
# Набор модификаторов: Укрепленный, Тиранический, Разъяренный, Усиливающий, Свирепый

#    DungeonMaster.Roguelike.AffixStartTier
#        Первый уровень, на котором применяется аффикс. Установите очень высокое значение, чтобы отключить эту функцию.
#        По умолчанию: 3
DungeonMaster.Roguelike.AffixStartTier = 3

#    DungeonMaster.Roguelike.SecondAffixTier
#        Уровень, на котором добавляется второй одновременный аффикс.
#        По умолчанию: 7
DungeonMaster.Roguelike.SecondAffixTier = 7

#    DungeonMaster.Roguelike.ThirdAffixTier
#        Уровень, на котором добавляется третий одновременный аффикс.
#        По умолчанию: 10
DungeonMaster.Roguelike.ThirdAffixTier = 10

# --- NPC-ТОРГОВЕЦ ---
# Создавайте дружелюбного торговца у входа в подземелье во время забегов в стиле «рогалик».
# Обеспечивает ремонт, реагенты, еду, воду и боеприпасы.
 
#    DungeonMaster.Roguelike.VendorEnable
#        По умолчанию: 1
DungeonMaster.Roguelike.VendorEnable = 1

# --- ПУЛ УСИЛЕНИЙ ---
# За каждое успешное прохождение подземелья группа получает случайный бонус из этого набора.
# Формат: "SpellId,DisplayName,Weight"
# Более высокий вес = выше вероятность выбора.
# Если конфигурация отсутствует, используется стандартный набор общеизвестных усилений (баффов) из WoW..

#    DungeonMaster.Roguelike.MaxBuffs
#        Максимальное количество накопленных усилений за забег.
#        По умолчанию: 20
DungeonMaster.Roguelike.MaxBuffs = 20

# Раскомментируйте и настройте, чтобы переопределить набор баффов по умолчанию:
# DungeonMaster.Roguelike.Buff.1  = "15366,Серенада из Цветущих песнопений,100"
# DungeonMaster.Roguelike.Buff.2  = "22888,Призыв к Сплочению,80"
# DungeonMaster.Roguelike.Buff.3  = "24425,Дух Зандалара,80"
# DungeonMaster.Roguelike.Buff.4  = "16609,Благословение Вождя,80"
# DungeonMaster.Roguelike.Buff.5  = "23768,Удача Ущерба,60"
# DungeonMaster.Roguelike.Buff.6  = "20217,Благословение Королей,90"
# DungeonMaster.Roguelike.Buff.7  = "48161,Слово силы: Стойкость,100"
# DungeonMaster.Roguelike.Buff.8  = "48469,Дар Дикой природы,100"
# DungeonMaster.Roguelike.Buff.9  = "19506,Аура Меткого выстрела,70"
# DungeonMaster.Roguelike.Buff.10 = "24932,Вожак Стаи,70"
